# Cloudflare Pages redirects.
#
# A real 301 for the root, so `/` does not rely on the meta-refresh fallback in
# src/pages/index.astro. French is default: Geneva is the primary market.
/                 /fr/    301

# Legacy/likely-typed paths for the language roots.
/fr               /fr/    301
/en               /en/    301
/de               /de/    301
/it               /it/    301

# The printed QR code on the Founding Book encodes /livre with no trailing
# slash. That exact URL must resolve - it cannot be corrected after printing.
/livre            /livre/ 308
