---
/**
 * Legal notice — /{lang}/legal/
 *
 * BLOCKER #1. The page always exists, because the footer always links to it;
 * what it CONTAINS depends on PUBLIC_SHOW_LEGAL_STATUS.
 *
 * While the client's instruction to withhold association and legal status
 * stands, this is a placeholder saying so and nothing else — no editor block,
 * no association wording, no legal footer. The full notice below it is only
 * generated once the flag is set, so there is nothing to leak in the meantime.
 *
 * The placeholder line is deliberately NOT `legal.pendingNotice`, which names
 * the association's articles; the whole point of the withholding is that the
 * page must not say that yet.
 */
import Page from '@/layouts/Page.astro';
import { getContent } from '@/lib/i18n';
import { LOCALES, SHOW_LEGAL_STATUS, type Locale } from '@/config/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const c = getContent(locale);
const l = c.legal;
const contact = c.sections.contact;
---

<Page locale={locale} path="legal/" title={l.title} eyebrow={c.footer.legalTitle}>
  {
    SHOW_LEGAL_STATUS ? (
      <div class="policy">
        <section class="policy__section">
          <h2 class="policy__title">{l.editorTitle}</h2>
          <ul class="policy__list">
            {contact.legalFooter.map((line) => <li>{line}</li>)}
          </ul>
          <address class="policy__address">
            <a class="link" href={`tel:${contact.phone.replace(/\s+/g, '')}`}>{contact.phone}</a>
            <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
          </address>
        </section>

        <section class="policy__section">
          <h2 class="policy__title">{l.hostingTitle}</h2>
          <p class="policy__body">{l.hostingBody}</p>
        </section>

        <section class="policy__section">
          <h2 class="policy__title">{l.propertyTitle}</h2>
          <p class="policy__body">{l.propertyBody}</p>
        </section>

        <p class="policy__pending">{l.pendingNotice}</p>
      </div>
    ) : (
      <p class="policy__placeholder">{l.placeholder}</p>
    )
  }
</Page>

<style>
  .policy {
    display: grid;
    gap: 2rem;
  }

  .policy__placeholder {
    margin: 0;
    color: var(--band-muted);
    max-width: 68ch;
  }

  .policy__title {
    font-size: var(--text-h3);
    margin: 0 0 0.625rem;
  }

  .policy__body {
    margin: 0;
    color: var(--band-muted);
    max-width: 68ch;
  }

  .policy__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
    color: var(--band-muted);
  }

  .policy__address {
    display: grid;
    gap: 0.25rem;
    margin-block-start: 0.875rem;
    font-style: normal;
  }

  .policy__pending {
    margin: 0;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--band-rule);
    border-radius: var(--radius-card);
    color: var(--band-muted);
    font-size: 0.875rem;
  }
</style>
