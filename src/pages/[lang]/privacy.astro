---
/**
 * Privacy policy.
 *
 * BLOCKER #5 - the client has not supplied this text and it is a legal
 * requirement under the Swiss FADP, because the contact form asks for consent
 * and must link somewhere real.
 *
 * What ships is an accurate description of what this site actually does with
 * data (which the developer can state truthfully) carrying a visible draft
 * notice. It is a starting point for the client's lawyer, not a substitute for
 * one. Set PUBLIC_PRIVACY_IS_DRAFT=false once the final text replaces the
 * bodies in src/content/authored/{loc}.json.
 */
import Page from '@/layouts/Page.astro';
import { getContent } from '@/lib/i18n';
import { LOCALES, PRIVACY_IS_DRAFT, type Locale } from '@/config/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const c = getContent(locale);
const p = c.privacy;
---

<Page locale={locale} path="privacy/" title={p.title} eyebrow={c.footer.legalTitle}>
  {
    PRIVACY_IS_DRAFT && (
      <aside class="draft" role="note">
        <p class="draft__badge mono-label">{p.draftBadge}</p>
        <p class="draft__body">{p.draftNotice}</p>
      </aside>
    )
  }

  <div class="policy">
    {
      p.sections.map((section) => (
        <section class="policy__section">
          <h2 class="policy__title">{section.title}</h2>
          <p class="policy__body">{section.body}</p>
        </section>
      ))
    }
  </div>
</Page>

<style>
  .draft {
    margin-block-end: 2.5rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--band-rule);
    border-inline-start: 3px solid var(--color-gold-bright);
    border-radius: var(--radius-card);
    background: var(--band-raised);
  }

  .draft__badge {
    margin: 0 0 0.5rem;
    color: var(--color-gold-bright);
  }

  .draft__body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--band-muted);
  }

  .policy {
    display: grid;
    gap: 2rem;
  }

  .policy__title {
    font-size: var(--text-h3);
    margin: 0 0 0.625rem;
  }

  .policy__body {
    margin: 0;
    color: var(--band-muted);
    max-width: 68ch;
  }
</style>
