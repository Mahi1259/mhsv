---
/**
 * The Phase 1 single page — one static document per locale.
 *
 * The page is a single continuous navy ground (`.flow`). Sections that call
 * for light relief are grouped into a few inset panels that float on it,
 * rather than being full-bleed light slabs: a stack of edge-to-edge colour
 * blocks is the slide-deck pattern, and no amount of tuning the numbering or
 * the dividers fixes that.
 *
 * Consecutive light sections collapse into ONE panel — nine separate panels
 * would just be nine rounded slides.
 */
import Base from '@/layouts/Base.astro';
import { LOCALES, SECTION_ORDER, type Locale, type SectionId } from '@/config/site';

import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import Vision from '@/components/sections/Vision.astro';
import Mission from '@/components/sections/Mission.astro';
import Audience from '@/components/sections/Audience.astro';
import Method from '@/components/sections/Method.astro';
import Services from '@/components/sections/Services.astro';
import Pathway from '@/components/sections/Pathway.astro';
import Programmes from '@/components/sections/Programmes.astro';
import Founding from '@/components/sections/Founding.astro';
import International from '@/components/sections/International.astro';
import Ecosystem from '@/components/sections/Ecosystem.astro';
import Inclusion from '@/components/sections/Inclusion.astro';
import Digital from '@/components/sections/Digital.astro';
import Team from '@/components/sections/Team.astro';
import Founder from '@/components/sections/Founder.astro';
import Book from '@/components/sections/Book.astro';
import Identity from '@/components/sections/Identity.astro';
import Roadmap from '@/components/sections/Roadmap.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import Contact from '@/components/sections/Contact.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;

const COMPONENTS = {
  about: About,
  vision: Vision,
  mission: Mission,
  audience: Audience,
  method: Method,
  services: Services,
  pathway: Pathway,
  programmes: Programmes,
  founding: Founding,
  international: International,
  ecosystem: Ecosystem,
  inclusion: Inclusion,
  digital: Digital,
  team: Team,
  founder: Founder,
  book: Book,
  identity: Identity,
  roadmap: Roadmap,
  newsletter: Newsletter,
  contact: Contact,
} as const;

/** Collapse consecutive same-surface sections into runs. */
type Run = { surface: 'ground' | 'panel'; ids: SectionId[] };

const runs: Run[] = [];
for (const section of SECTION_ORDER) {
  if (section.id === 'hero') continue;
  const surface: Run['surface'] = section.surface;
  const last = runs.at(-1);
  if (last?.surface === surface) last.ids.push(section.id);
  else runs.push({ surface, ids: [section.id] });
}

const propsFor = (id: SectionId) => {
  const section = SECTION_ORDER.find((s) => s.id === id)!;
  return { type: section.type, surface: section.surface };
};
---

<Base locale={locale}>
  <div class="flow">
    <Hero locale={locale} />
    {
      runs.map((run) =>
        run.surface === 'panel' ? (
          <div class="panel">
            {run.ids.map((id) => {
              const Section = COMPONENTS[id as keyof typeof COMPONENTS];
              return <Section locale={locale} {...propsFor(id)} />;
            })}
          </div>
        ) : (
          run.ids.map((id) => {
            const Section = COMPONENTS[id as keyof typeof COMPONENTS];
            return <Section locale={locale} {...propsFor(id)} />;
          })
        ),
      )
    }
  </div>
</Base>
