---
/**
 * The Phase 1 single page — one static document per locale.
 *
 * Archetype and ground for each section come from SECTION_ORDER, so the
 * rhythm of the page is declared in one place. `fade` is computed here: a
 * section gets the gradient hand-off when it is the first of a new ground.
 */
import Base from '@/layouts/Base.astro';
import { LOCALES, SECTION_ORDER, type Locale, type SectionId } from '@/config/site';

import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import Vision from '@/components/sections/Vision.astro';
import Mission from '@/components/sections/Mission.astro';
import Audience from '@/components/sections/Audience.astro';
import Method from '@/components/sections/Method.astro';
import Services from '@/components/sections/Services.astro';
import Pathway from '@/components/sections/Pathway.astro';
import Programmes from '@/components/sections/Programmes.astro';
import Founding from '@/components/sections/Founding.astro';
import International from '@/components/sections/International.astro';
import Ecosystem from '@/components/sections/Ecosystem.astro';
import Inclusion from '@/components/sections/Inclusion.astro';
import Digital from '@/components/sections/Digital.astro';
import Team from '@/components/sections/Team.astro';
import Founder from '@/components/sections/Founder.astro';
import Book from '@/components/sections/Book.astro';
import Identity from '@/components/sections/Identity.astro';
import Roadmap from '@/components/sections/Roadmap.astro';
import Newsletter from '@/components/sections/Newsletter.astro';
import Contact from '@/components/sections/Contact.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;

/** Archetype, ground, and whether this section opens a new ground. */
function band(id: SectionId) {
  const index = SECTION_ORDER.findIndex((s) => s.id === id);
  const section = SECTION_ORDER[index];
  const previous = index > 0 ? SECTION_ORDER[index - 1] : null;
  return {
    type: section.type,
    tone: section.tone,
    fade: Boolean(previous && previous.tone !== section.tone),
  };
}

const COMPONENTS = {
  about: About,
  vision: Vision,
  mission: Mission,
  audience: Audience,
  method: Method,
  services: Services,
  pathway: Pathway,
  programmes: Programmes,
  founding: Founding,
  international: International,
  ecosystem: Ecosystem,
  inclusion: Inclusion,
  digital: Digital,
  team: Team,
  founder: Founder,
  book: Book,
  identity: Identity,
  roadmap: Roadmap,
  newsletter: Newsletter,
  contact: Contact,
} as const;
---

<Base locale={locale}>
  <Hero locale={locale} />
  {
    SECTION_ORDER.filter((s) => s.id !== 'hero').map((section) => {
      const Section = COMPONENTS[section.id as keyof typeof COMPONENTS];
      return <Section locale={locale} {...band(section.id)} />;
    })
  }
</Base>
