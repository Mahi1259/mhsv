---
/**
 * Legal notice.
 *
 * BLOCKER #1 — this page is only generated when PUBLIC_SHOW_LEGAL_STATUS is
 * true. While the client's instruction to withhold association and legal
 * status stands, getStaticPaths returns nothing and the page does not exist in
 * the build at all, so there is no URL to find and nothing to leak.
 */
import Page from '@/layouts/Page.astro';
import { getContent } from '@/lib/i18n';
import { LOCALES, SHOW_LEGAL_STATUS, type Locale } from '@/config/site';

export function getStaticPaths() {
  if (!SHOW_LEGAL_STATUS) return [];
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const c = getContent(locale);
const l = c.legal;
const contact = c.sections.contact;
---

<Page locale={locale} path="legal-notice/" title={l.title} eyebrow={c.footer.legalTitle}>
  <div class="policy">
    <section class="policy__section">
      <h2 class="policy__title">{l.editorTitle}</h2>
      <ul class="policy__list">
        {contact.legalFooter.map((line) => <li>{line}</li>)}
      </ul>
      <address class="policy__address">
        <a class="link" href={`tel:${contact.phone.replace(/\s+/g, '')}`}>{contact.phone}</a>
        <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
      </address>
    </section>

    <section class="policy__section">
      <h2 class="policy__title">{l.hostingTitle}</h2>
      <p class="policy__body">{l.hostingBody}</p>
    </section>

    <section class="policy__section">
      <h2 class="policy__title">{l.propertyTitle}</h2>
      <p class="policy__body">{l.propertyBody}</p>
    </section>

    <p class="policy__pending">{l.pendingNotice}</p>
  </div>
</Page>

<style>
  .policy {
    display: grid;
    gap: 2rem;
  }

  .policy__title {
    font-size: var(--text-h3);
    margin: 0 0 0.625rem;
  }

  .policy__body {
    margin: 0;
    color: var(--band-muted);
    max-width: 68ch;
  }

  .policy__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
    color: var(--band-muted);
  }

  .policy__address {
    display: grid;
    gap: 0.25rem;
    margin-block-start: 0.875rem;
    font-style: normal;
  }

  .policy__pending {
    margin: 0;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--band-rule);
    border-radius: var(--radius-card);
    color: var(--band-muted);
    font-size: 0.875rem;
  }
</style>
