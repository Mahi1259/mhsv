---
import Page from '@/layouts/Page.astro';
import { getContent } from '@/lib/i18n';
import { LOCALES, LEGAL_PAGES, type Locale } from '@/config/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang, credits: LEGAL_PAGES.photoCredits[lang].replace(/\/$/, '') },
  }));
}

const locale = Astro.params.lang as Locale;
const c = getContent(locale);
const p = c.photoCredits;
---

<Page
  locale={locale}
  path={LEGAL_PAGES.photoCredits[locale]}
  title={p.title}
  eyebrow={c.footer.legalTitle}
>
  <p class="credits__intro">{p.intro}</p>
  <ol class="credits">
    {
      p.items.map((item) => (
        <li>
          <a class="link" href={item.url} rel="noopener noreferrer" target="_blank">
            {item.name}
          </a>
        </li>
      ))
    }
  </ol>
</Page>
<style>
  .credits__intro {
    margin: 0 0 2rem;
    color: var(--band-muted);
    max-width: 68ch;
  }

  .credits {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding-inline-start: 1.5rem;
    color: var(--band-muted);
  }

  .credits li {
    overflow-wrap: anywhere;
  }
</style>
