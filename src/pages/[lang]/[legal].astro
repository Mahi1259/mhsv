---
/**
 * The four legal pages, one route for all of them.
 *
 * Two now carry MHSV®'s approved text - the legal notice and the data
 * protection notice - each under a banner saying it is still a technical
 * validation version. Cookies and forms are still one line saying the wording
 * is with counsel.
 *
 * The slug is per language - /fr/mentions-legales/ and /en/legal-notice/ are
 * the same page - so getStaticPaths pairs each locale with its own slug from
 * LEGAL_PAGES rather than repeating one path four times.
 */
import Page from '@/layouts/Page.astro';
import { getContent } from '@/lib/i18n';
import { LOCALES, LEGAL_PAGES, LEGAL_PAGE_IDS, type Locale } from '@/config/site';

/*
 * The four this route actually builds - NOT LegalPageId, which also covers
 * photoCredits. That page has its own route and its own title, and typing the
 * prop as the wider union asked for a title key that does not exist.
 */
type PlaceholderPageId = (typeof LEGAL_PAGE_IDS)[number];

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    LEGAL_PAGE_IDS.map((page) => ({
      params: { lang, legal: LEGAL_PAGES[page][lang].replace(/\/$/, '') },
      props: { page },
    })),
  );
}

const locale = Astro.params.lang as Locale;
const { page } = Astro.props as { page: PlaceholderPageId };
const c = getContent(locale);
const title = c.legalPages.titles[page];

/*
 * Three of the four carry their approved text; only forms is still a
 * placeholder waiting on counsel.
 *
 * The legal notice and the data protection notice are "validation technique"
 * versions, so both render under a banner saying so. Those banners are REQUIRED
 * and must not be removed without an explicit instruction. The cookies page is
 * MHSV®'s own wording for the site rather than a document under review, so it
 * has none.
 *
 * Only sections 1-11 of the legal notice are here. The cover page, the "read
 * before integration" instructions, the validation-scope note and the technical
 * validation sheet are deliberately not in the content files at all - not
 * hidden by a flag, absent - so there is nothing to publish by accident.
 */
const NOTICES = {
  dataProtection: c.dataProtection,
  legalNotice: c.legalNotice,
  cookies: c.cookiePolicy,
} as const;
const notice = page in NOTICES ? NOTICES[page as keyof typeof NOTICES] : null;

---

<Page locale={locale} path={LEGAL_PAGES[page][locale]} title={title} eyebrow={c.footer.legalTitle}>
  {
    notice ? (
      <div class="notice">
        {/* Only the two documents still awaiting validation carry one. */}
        {notice.banner && <p class="notice__banner" role="note">{notice.banner}</p>}

        {notice.officialLanguagesNote && (
          <p class="notice__languages">{notice.officialLanguagesNote}</p>
        )}

        {notice.sections.map((section) => (
          <section class="notice__section">
            {section.heading && <h2 class="notice__heading">{section.heading}</h2>}
            {section.paragraphs.map((text) => (
              <p class="notice__p">{text}</p>
            ))}
            {section.items.length > 0 && (
              <ul class="notice__list">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {notice.version && <p class="notice__version">{notice.version}</p>}
      </div>
    ) : (
      <p class="legal-pending">{c.legalPages.pending}</p>
    )
  }
</Page>

<style>
  .notice {
    max-width: 74ch;
  }

  /* Deliberately loud. The source document is a technical-validation version
     marked "do not publish", so a reader must not mistake this for the final
     notice. */
  .notice__banner {
    margin: 0 0 2rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--gold) 9%, transparent);
    color: var(--gold-soft);
    font-size: 0.9375rem;
  }

  .notice__languages {
    margin: 0 0 2rem;
    color: var(--band-muted);
    font-size: 0.9375rem;
  }

  .notice__section {
    margin-block-start: 2rem;
  }

  .notice__heading {
    margin: 0 0 0.75rem;
    font-size: var(--text-h3);
  }

  .notice__p {
    margin: 0 0 0.875rem;
    color: var(--band-muted);
  }

  .notice__list {
    margin: 0 0 0.875rem;
    padding-inline-start: 1.25rem;
    display: grid;
    gap: 0.5rem;
    color: var(--band-muted);
  }

  .notice__version {
    margin-block-start: 2.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--band-rule);
    color: var(--band-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .legal-pending {
    margin: 0;
    color: var(--band-muted);
    max-width: 68ch;
  }
</style>
