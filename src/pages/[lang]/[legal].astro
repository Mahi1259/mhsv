---
import Page from '@/layouts/Page.astro';
import { getContent } from '@/lib/i18n';
import { LOCALES, LEGAL_PAGES, LEGAL_PAGE_IDS, type Locale } from '@/config/site';

type PlaceholderPageId = (typeof LEGAL_PAGE_IDS)[number];

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    LEGAL_PAGE_IDS.map((page) => ({
      params: { lang, legal: LEGAL_PAGES[page][lang].replace(/\/$/, '') },
      props: { page },
    })),
  );
}

const locale = Astro.params.lang as Locale;
const { page } = Astro.props as { page: PlaceholderPageId };
const c = getContent(locale);
const title = c.legalPages.titles[page];

// Three of the four carry approved text; forms is still waiting on counsel.
const NOTICES = {
  dataProtection: c.dataProtection,
  legalNotice: c.legalNotice,
  cookies: c.cookiePolicy,
} as const;
const notice = page in NOTICES ? NOTICES[page as keyof typeof NOTICES] : null;

---

<Page locale={locale} path={LEGAL_PAGES[page][locale]} title={title} eyebrow={c.footer.legalTitle}>
  {
    notice ? (
      <div class="notice">
        {/* Required until the client validates these documents - do not remove. */}
        {notice.banner && <p class="notice__banner" role="note">{notice.banner}</p>}

        {notice.officialLanguagesNote && (
          <p class="notice__languages">{notice.officialLanguagesNote}</p>
        )}

        {notice.sections.map((section) => (
          <section class="notice__section">
            {section.heading && <h2 class="notice__heading">{section.heading}</h2>}
            {section.paragraphs.map((text) => (
              <p class="notice__p">{text}</p>
            ))}
            {section.items.length > 0 && (
              <ul class="notice__list">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {notice.version && <p class="notice__version">{notice.version}</p>}
      </div>
    ) : (
      <p class="legal-pending">{c.legalPages.pending}</p>
    )
  }
</Page>
<style>
  .notice {
    max-width: 74ch;
  }

  .notice__banner {
    margin: 0 0 2rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--gold) 9%, transparent);
    color: var(--gold-soft);
    font-size: 0.9375rem;
  }

  .notice__languages {
    margin: 0 0 2rem;
    color: var(--band-muted);
    font-size: 0.9375rem;
  }

  .notice__section {
    margin-block-start: 2rem;
  }

  .notice__heading {
    margin: 0 0 0.75rem;
    font-size: var(--text-h3);
  }

  .notice__p {
    margin: 0 0 0.875rem;
    color: var(--band-muted);
  }

  .notice__list {
    margin: 0 0 0.875rem;
    padding-inline-start: 1.25rem;
    display: grid;
    gap: 0.5rem;
    color: var(--band-muted);
  }

  .notice__version {
    margin-block-start: 2.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--band-rule);
    color: var(--band-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .legal-pending {
    margin: 0;
    color: var(--band-muted);
    max-width: 68ch;
  }
</style>
