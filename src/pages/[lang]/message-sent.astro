---
/**
 * Confirmation page for visitors without JavaScript.
 *
 * The contact function 303-redirects here after a successful send. With
 * JavaScript the submit is intercepted and the same wording is shown inline,
 * so this page is never reached.
 */
import Page from '@/layouts/Page.astro';
import { getContent, localePath } from '@/lib/i18n';
import { LOCALES, type Locale } from '@/config/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const c = getContent(locale);
---

<Page locale={locale} path="message-sent/" title={c.form.successTitle} noindex>
  <p class="result">{c.form.successBody}</p>
  <a class="btn btn-secondary" href={localePath('', locale)}>{c.nav.items[0].label}</a>
</Page>

<style>
  .result {
    margin: 0 0 2rem;
    font-size: var(--text-lead);
    font-weight: 400;
    color: var(--band-muted);
    max-width: 56ch;
  }
</style>
