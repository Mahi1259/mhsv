---
/**
 * /livre - the permanent destination of the printed QR code.
 *
 * THIS URL MUST NOT CHANGE. It is encoded in the QR on the back cover of both
 * editions; once printed, it cannot be corrected. If the page ever moves,
 * keep /livre and redirect server-side from here.
 *
 * Deliberately NOT locale-prefixed: the QR is the same in the French and
 * English editions because this page is bilingual. It shows FR and EN side by
 * side rather than picking one.
 *
 * Contains only what the client approved: the two covers, the institutional
 * copy, and the order-request form. There is no download of the complete book
 * and no path that could become one.
 */
import { Picture } from 'astro:assets';
import BookOrderForm from '@/components/BookOrderForm.astro';
import Bilingual from '@/components/Bilingual.astro';
import QrPlaceholder from '@/components/QrPlaceholder.astro';
import { Image } from 'astro:assets';
import crest from '@/assets/logo/mhsv-crest.png';
import { getContent, localePath } from '@/lib/i18n';
import { SITE_URL, IS_PRODUCTION, BOOK_PAGE_PATH } from '@/config/site';
import preloadFonts from '@/config/preload-fonts.json';
import coverFr from '@/assets/book/founding-book-fr.png';
import coverEn from '@/assets/book/founding-book-en.png';
import '@/styles/global.css';

const fr = getContent('fr');
const en = getContent('en');

const canonical = new URL(BOOK_PAGE_PATH + '/', SITE_URL).href;
const ogImage = new URL('/og-image.png', SITE_URL).href;

const covers = [
  { src: coverFr, alt: fr.sections.book.coverAltFr, edition: 'FR' },
  { src: coverEn, alt: en.sections.book.coverAltEn, edition: 'EN' },
];

const columns = [
  { htmlLang: 'fr-CH', c: fr },
  { htmlLang: 'en', c: en },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fr.sections.book.title} | MHSV®</title>
    <meta
      name="description"
      content={`${fr.sections.book.body.slice(0, 150)}…`}
    />
    {!IS_PRODUCTION && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MHSV®" />
    <meta property="og:title" content={`${fr.sections.book.title} | MHSV®`} />
    <meta property="og:description" content={fr.sections.book.lead} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0C1D3A" />
    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
  </head>

  <script is:inline>
    /*
     * Page language, decided before the first paint.
     *
     * The document carries both languages; `?lang=en` selects English and
     * anything else - including no query at all - leaves French, which is the
     * default and the state the printed QR lands on. The stylesheet does the
     * hiding, so this only has to set the attribute, and it has to do it here
     * rather than at the end of the body or both languages flash first.
     */
    (function () {
      var lang = /(^|[?&])lang=en(&|$)/.test(location.search) ? 'en' : 'fr';
      document.documentElement.setAttribute('data-lang', lang);
      document.documentElement.lang = lang === 'en' ? 'en' : 'fr';
    })();
  </script>

  <body>
    <a class="skip-link" href="#book">Aller au contenu / Skip to content</a>

    {/*
      The site's masthead, reduced to what this page needs: the mark, and the
      two languages this page is published in. No section links - there are no
      sections here - and no DE or IT, because the book is not.

      Real links carrying `?lang=`, so a choice is shareable and survives a
      reload. translate="no" for the same reason as the main masthead: Chrome
      auto-translation rewrites the codes, turning EN into IN.
    */}
    <header class="livre-header">
      <div class="livre-header__inner">
        <a class="livre-brand notranslate" href={localePath('', 'fr')} translate="no">
          <Image src={crest} alt="" width={32} height={36} loading="eager" densities={[1, 2]} />
          <span>MHSV®</span>
        </a>

        <nav class="livre-lang notranslate" aria-label="Langue / Language" translate="no">
          <a href="?lang=fr" hreflang="fr" data-lang-chip="fr">
            <span class="visually-hidden">Français</span>
            <span aria-hidden="true">FR</span>
          </a>
          <a href="?lang=en" hreflang="en" data-lang-chip="en">
            <span class="visually-hidden">English</span>
            <span aria-hidden="true">EN</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="book">
      <section class="band livre">
        <div class="shell livre__inner">
          <div class="livre__covers">
            <ul>
              {
                covers.map((cover) => (
                  <li style={`flex-grow: ${cover.src.width / cover.src.height}`}>
                    {/* Flex-grow set to the cover's own aspect ratio, so the two
                        widths come out in proportion to their shapes and the two
                        HEIGHTS come out equal. The supplied files no longer share a
                        ratio once their pale borders are trimmed - 0.697 and 0.752 -
                        and equal widths made one book look smaller than the other. */}
                    <Picture
                      src={cover.src}
                      alt={cover.alt}
                      formats={['webp']}
                      fallbackFormat="png"
                      widths={[300, 520, 700]}
                      sizes="(min-width: 60rem) 17rem, 42vw"
                      loading="eager"
                    />
                    <span
                      class="livre__edition mono-label notranslate"
                      aria-hidden="true"
                      translate="no"
                    >
                      {cover.edition}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="livre__text">
            {
              columns.map(({ htmlLang, c }) => (
                <article class="livre__lang l10n" lang={htmlLang}>
                  <h1 class="livre__title">{c.sections.book.lead}</h1>
                  <p class="livre__body">{c.sections.book.body}</p>
                </article>
              ))
            }
            <p class="livre__notice">
              <span class="l10n" lang="fr-CH">{fr.sections.book.notice}</span>
              <span class="l10n" lang="en">{en.sections.book.notice}</span>
            </p>
          </div>
        </div>
      </section>

      <section class="band livre-order" aria-labelledby="order-title">
        <div class="shell shell--mid">
          <h2 id="order-title" class="section-title livre-order__title">
            <Bilingual fr={fr.bookOrder.title} en={en.bookOrder.title} />
          </h2>
          {/* French first, English beside it - the form matches the page. The
              visitor still picks which EDITION of the book they want inside. */}
          {/* Reserved, not generated: the printed code must encode
            https://www.mhsv.ch/livre and can only be made once that domain is
            live. This is the page it will point AT. */}
        <QrPlaceholder locale="fr" altLocale="en" class="livre-qr" />

        <BookOrderForm locale="fr" altLocale="en" />
        </div>
      </section>
    </main>

    <footer class="band livre-footer">
      <div class="shell">
        <p><Bilingual fr={fr.footer.summary} en={en.footer.summary} /></p>
      </div>
    </footer>

    <script is:inline>
      /*
       * The parts that need the document parsed. Still inline and still ahead
       * of the bundled modules, so the form has its messages in the right
       * language before scripts/forms.ts ever reads them.
       */
      (function () {
        var lang = document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'fr';

        var chip = document.querySelector('[data-lang-chip="' + lang + '"]');
        if (chip) chip.setAttribute('aria-current', 'true');

        if (lang === 'en') {
          var alt = document.querySelector('[data-form-strings-alt]');
          var main = document.querySelector('[data-form-strings]');
          if (alt && main) main.textContent = alt.textContent;

          var submit = document.querySelector('[data-sending-label-alt]');
          if (submit) submit.setAttribute('data-sending-label', submit.getAttribute('data-sending-label-alt'));
        }
      })();
    </script>

    <script>
      import '@/scripts/motion.ts';
      import '@/scripts/forms.ts';
    </script>
  </body>
</html>

<style is:global>
  /*
   * ONE LANGUAGE AT A TIME.
   *
   * Every translatable fragment on this page is an element marked `.l10n`
   * carrying its own `lang` - in the copy, and inside the order form via
   * components/Bilingual.astro. French is the default and needs no attribute,
   * so with no JavaScript, or on a bare /livre, the French half is what shows
   * and the page is complete. `?lang=en` sets data-lang on <html> and the two
   * halves swap.
   *
   * Global rather than scoped: the form's halves are rendered by another
   * component, and a scoped rule would not reach them.
   */
  html:not([data-lang='en']) .l10n[lang|='en'] {
    display: none;
  }

  html[data-lang='en'] .l10n[lang|='fr'] {
    display: none;
  }
</style>

<style>
  /*
   * FIXED, matching the main masthead.
   *
   * It was sticky, so it sat BELOW the space `body` reserves for the site's
   * fixed bar - 68.8px of dead navy above it, which is the gap this page had
   * between the top of the window and its own header. Fixed, it occupies that
   * reserved space instead of adding to it.
   */
  .livre-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
  }

  /* Mobile, and the base case: a plain solid bar, exactly as the site's. */
  .livre-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 78rem;
    min-height: 4.25rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 0.5rem + 3.4vw, 4rem);
    background: color-mix(in srgb, var(--navy-deep) 94%, transparent);
    border-block-end: 1px solid var(--hairline);
  }

  /*
   * On desktop it wears the same floating pill the site's masthead does once
   * scrolled - held in that state permanently rather than shrinking, since
   * there are no sections here to scroll past. Same measurements, so the two
   * pages read as one site.
   */
  @media (min-width: 62rem) {
    .livre-header {
      padding: 0.85rem 1rem 0;
    }

    .livre-header__inner {
      max-width: 61rem;
      min-height: 3.25rem;
      padding-inline: 1.4rem;
      border: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
      border-block-end: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--navy-deep) 82%, transparent);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      box-shadow:
        0 8px 32px rgb(0 0 0 / 0.3),
        0 1px 0 rgb(255 255 255 / 0.05) inset;
    }
  }

  .livre-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    transition: opacity 180ms var(--ease);
  }

  .livre-brand:hover {
    opacity: 0.82;
  }

  .livre-brand :global(img) {
    width: 1.75rem;
    height: auto;
  }

  /* The site's language chips, cut to the two languages the book exists in. */
  .livre-lang {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .livre-lang a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--muted-on-dark);
    text-decoration: none;
    border-radius: 3px;
    transition: color 180ms var(--ease), background-color 180ms var(--ease);
  }

  .livre-lang a:hover {
    color: var(--gold-soft);
  }

  .livre-lang a[aria-current='true'] {
    color: var(--navy-deep);
    background: var(--gold);
  }

  /*
   * On desktop it wears the same floating pill the site's masthead does once
   * scrolled - held in that state permanently rather than shrinking, since
   * there are no sections here to scroll past. Same measurements, so the two
   * pages read as one site.
   */
  @media (min-width: 62rem) {
    .livre-header {
      padding: 0.85rem 1rem 0;
    }

    .livre-header__inner {
      max-width: 61rem;
      min-height: 3.25rem;
      padding-inline: 1.4rem;
      border: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
      border-block-end: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--navy-deep) 82%, transparent);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      box-shadow:
        0 8px 32px rgb(0 0 0 / 0.3),
        0 1px 0 rgb(255 255 255 / 0.05) inset;
    }
  }

  .livre {
    /* Opens tighter than it closes: the fixed bar already leaves --header-h of
       clear space above this, so a full 6rem on top read as a hole. */
    padding-block: clamp(2rem, 1.25rem + 2.5vw, 3rem) clamp(3rem, 2rem + 6vw, 6rem);
  }

  .livre__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .livre__covers ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .livre__covers li {
    position: relative;
    /* grow is set per cover, inline, from its aspect ratio. */
    flex: 0 1 0;
    max-width: 21rem;
  }

  .livre__covers :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
    box-shadow: 0 24px 50px rgb(0 0 0 / 0.5);
  }

  .livre__edition {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    padding: 0.1875rem 0.4375rem;
    background: var(--navy-deep);
    color: var(--gold);
    font-size: 0.625rem;
  }

  /*
   * Divided the two language blocks when both were on screen. Only one is
   * now, so the rule would sit above it dividing nothing - `display: none`
   * does not stop `+` matching, and the hidden block is still the previous
   * sibling. Reinstated only if a build ever shows both again.
   */
  .livre__lang + .livre__lang {
    margin-block-start: 0;
    padding-block-start: 0;
    border-block-start: 0;
  }

  .livre__title {
    margin: 0 0 0.875rem;
    font-size: clamp(1.125rem, 0.95rem + 0.85vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--gold-soft);
  }

  .livre__body {
    margin: 0;
    color: var(--muted-on-dark);
    max-width: 62ch;
  }

  .livre__notice {
    display: grid;
    gap: 0.375rem;
    margin-block-start: 2rem;
    padding: 0.875rem 1.125rem;
    border: 1px dashed var(--hairline);
    border-radius: var(--radius);
    color: var(--muted-on-dark);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .livre-order {
    padding-block: clamp(3rem, 2rem + 5vw, 5.5rem);
  }

  .livre-order__title {
    max-width: none;
  }

  .livre-footer {
    padding-block: 2.5rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--muted-on-dark);
    font-size: 0.8125rem;
  }

  .livre-footer p {
    margin: 0 0 0.5rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 60rem) {
    .livre__inner {
      /* The covers are the reason anyone scanned the code; they were sized
         like a thumbnail beside the copy. `align-items: center` on the base
         rule then holds them against the middle of the text rather than its
         top, which only shows once one language is on screen at a time. */
      grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
