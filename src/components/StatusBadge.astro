---
import { getContent, type Locale } from '@/lib/i18n';
import type { StatusKey } from '@/config/site';

interface Props {
  locale: Locale;
  status: StatusKey;
  class?: string;
}

const { locale, status, class: className } = Astro.props;
const c = getContent(locale);
const item = c.status.items[status];
---

<p class:list={['status', `status--${status}`, className]} title={item.description}>
  <span class="status__dot" aria-hidden="true"></span>
  <span>{item.label}</span>
  <span class="visually-hidden">: {item.description}</span>
</p>
<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.3125rem 0.6875rem;
    border: 1px solid var(--band-rule);
    border-radius: 999px;
    background: var(--band-raised);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--band-fg);
  }

  .status__dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--status-accent, var(--band-accent));
    flex: 0 0 auto;
  }

  .status--active {
    --status-accent: #4f9d69;
  }

  .status--inDevelopment {
    --status-accent: var(--band-accent);
  }

  .status--pilot {
    --status-accent: #5b8db8;
  }

  .status--partnership {
    --status-accent: #a1789e;
  }

  .status--future {
    --status-accent: var(--band-muted);
  }
</style>
