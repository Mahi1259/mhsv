---
import { getContent, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);

const track = locale === 'fr' ? 'fr' : 'en';

const VIDEO = `/video/mhsv-presentation-${track}`;
const SUBTITLES = `/video/mhsv-subtitles-${track}.vtt`;
const POSTER = '/video/mhsv-presentation-poster.webp';
---

<div class="video">
  <video
    class="video__el"
    controls
    muted
    playsinline
    preload="none"
    poster={POSTER}
    aria-label={c.video.ariaLabel}
    width="1920"
    height="1080"
  >
    <source src={`${VIDEO}.webm`} type="video/webm" />
    <source src={`${VIDEO}.mp4`} type="video/mp4" />
  {/* <track> accepts WebVTT only - an .srt here fails silently. */}
    <track kind="subtitles" src={SUBTITLES} srclang={track} label={c.video.subtitles} default />
  </video>
</div>
<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--gold) 22%, transparent);
    border-radius: var(--radius);
    background: var(--navy-deep);
  }

  .video__el {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--navy-deep);
  }
</style>
