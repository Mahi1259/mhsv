---
/** Contact form. Recipient comes from CONTACT_RECIPIENT - never hard-coded. */
import FormShell from '@/components/FormShell.astro';
import { getContent, localePath, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const f = c.form;
const privacyHref = localePath('privacy/', locale);

// The consent label embeds a link. Split on the link label so the surrounding
// wording stays translatable as one string.
const [before, ...rest] = f.consent.split(f.consentLinkLabel);
const after = rest.join(f.consentLinkLabel);

const strings = {
  errors: f.errors,
  successTitle: f.successTitle,
  successBody: f.successBody,
  errorTitle: f.errorTitle,
  errorBody: f.errorBody,
};
---

<FormShell locale={locale} kind="contact" id="contact-form" submitLabel={f.submit} strings={strings}>
  <div class="form__grid">
    <p class="form__field">
      <label for="firstName">{f.firstName} <span class="form__req" aria-hidden="true">*</span></label>
      <input id="firstName" name="firstName" type="text" required autocomplete="given-name" maxlength="80" aria-describedby="firstName-error" />
      <span class="form__error" id="firstName-error" data-error-for="firstName"></span>
    </p>

    <p class="form__field">
      <label for="lastName">{f.lastName} <span class="form__req" aria-hidden="true">*</span></label>
      <input id="lastName" name="lastName" type="text" required autocomplete="family-name" maxlength="80" aria-describedby="lastName-error" />
      <span class="form__error" id="lastName-error" data-error-for="lastName"></span>
    </p>

    <p class="form__field">
      <label for="email">{f.email} <span class="form__req" aria-hidden="true">*</span></label>
      <input id="email" name="email" type="email" required autocomplete="email" maxlength="254" aria-describedby="email-error" />
      <span class="form__error" id="email-error" data-error-for="email"></span>
    </p>

    <p class="form__field">
      <label for="phone">{f.phone} <span class="form__optional">({c.ui.optional})</span></label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby="phone-error" />
      <span class="form__error" id="phone-error" data-error-for="phone"></span>
    </p>

    <p class="form__field form__field--wide">
      <label for="profile">{f.profile} <span class="form__req" aria-hidden="true">*</span></label>
      <input id="profile" name="profile" type="text" required maxlength="120" placeholder={f.profilePlaceholder} aria-describedby="profile-error" />
      <span class="form__error" id="profile-error" data-error-for="profile"></span>
    </p>

    <p class="form__field form__field--wide">
      <label for="subject">{f.subject} <span class="form__req" aria-hidden="true">*</span></label>
      <input id="subject" name="subject" type="text" required maxlength="160" aria-describedby="subject-error" />
      <span class="form__error" id="subject-error" data-error-for="subject"></span>
    </p>

    <p class="form__field form__field--wide">
      <label for="message">{f.message} <span class="form__req" aria-hidden="true">*</span></label>
      <textarea id="message" name="message" rows="6" required maxlength="5000" aria-describedby="message-error"></textarea>
      <span class="form__error" id="message-error" data-error-for="message"></span>
    </p>
  </div>

  <div>
    <p class="form__consent">
      <input id="consent" name="consent" type="checkbox" required aria-describedby="consent-error" />
      <label for="consent">
        {before}<a class="link" href={privacyHref}>{f.consentLinkLabel}</a>{after}
        <span class="form__req" aria-hidden="true"> *</span>
      </label>
    </p>
    <span class="form__error" id="consent-error" data-error-for="consent"></span>
  </div>
</FormShell>
