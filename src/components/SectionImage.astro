---
/**
 * A licensed photograph for a section, rendered only if the file is there.
 *
 * The four slots are declared in the markup and in IMAGE_BRIEF.md; the files
 * are not in the repository yet. Rather than shipping broken images or a
 * hard-coded import that fails the build, this looks the file up and renders
 * nothing when it is absent - so the site is correct with no photographs and
 * complete the moment they are dropped in.
 *
 * The credit line is required for Pexels and optional for Unsplash. It renders
 * whenever `credit` is present in the content, so the licence is honoured by
 * the page rather than by a promise in a document.
 */
import { Picture } from 'astro:assets';
import { getContent, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
  /**
   * Matches the file stem in src/assets/stock/ and the key in content.
   *
   * NOT called `slot`. `slot` is reserved in Astro for named-slot assignment,
   * so `<SectionImage slot="about" />` was read as "put this child in the
   * parent's slot named about" - and since Band has only a default slot, the
   * component was dropped without rendering and without error.
   */
  image: 'about' | 'mission' | 'audience' | 'programmes' | 'services' | 'fees' | 'ecosystem';
  /** Above the fold loads eagerly; everything else waits. */
  eager?: boolean;
}

const { locale, image, eager = false } = Astro.props;
const c = getContent(locale);

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/stock/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const entry = Object.entries(files).find(
  ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === image,
);
const meta = c.stock[image] as { alt: string; credit?: string };
---

{
  entry && (
    <figure class="section-image">
      <Picture
        src={entry[1].default}
        alt={meta.alt}
        formats={['webp']}
        {/* jpg, not png. These are photographs: a PNG fallback of a 2000px
            photo runs to tens of megabytes - one reached 56MB - because PNG is
            lossless and built for flat colour, not for continuous tone. */}
        fallbackFormat="jpg"
        widths={[640, 1000, 1600]}
        {/* Measured, not guessed: inside a band's content column these render
            918px wide at a 1440px viewport, so a 40rem (640px) hint had the
            browser fetching a source 0.7x the size it was drawing. */}
        sizes="(min-width: 62rem) 58rem, 92vw"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {meta.credit && <figcaption class="section-image__credit">{meta.credit}</figcaption>}
    </figure>
  )
}

<style>
  .section-image {
    margin: 0;
  }

  .section-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--band-rule);
    border-radius: var(--radius);
  }

  .section-image__credit {
    margin-block-start: 0.5rem;
    color: var(--band-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }
</style>
