---
/**
 * Reserved space for the Founding Book QR code, which does not exist yet.
 *
 * NOTHING IS GENERATED HERE ON PURPOSE. The final code must encode
 * https://www.mhsv.ch/livre and can only be made once that domain is live and
 * MHSV® has approved the destination - see scripts/generate-qr.mjs, which stays
 * gated behind MHSV_QR_APPROVED for exactly that reason. A printed QR cannot be
 * corrected, so a provisional one that escapes into a layout is the failure
 * this avoids.
 *
 * Same treatment as VideoPlaceholder: role="img" with a label rather than an
 * empty square. The reservation is information - a reader should be told what
 * is coming, not shown a blank box - and it is not a link, because there is
 * nothing yet to follow.
 *
 * `lang` is accepted so /livre, which shows French and English together, can
 * label it in both.
 */
import { getContent, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
  /** Rendered alongside `locale` for the bilingual book page. */
  altLocale?: Locale;
  class?: string;
}

const { locale, altLocale, class: className } = Astro.props;
const qr = getContent(locale).sections.book.qr;
const alt = altLocale ? getContent(altLocale).sections.book.qr : null;
---

<div class:list={['qr-slot', className]} role="img" aria-label={qr.ariaLabel}>
  <div class="qr-slot__frame" aria-hidden="true">
    {/* Four corner marks, not a full border: it reads as a reserved area
        rather than as an empty input. */}
    <span class="qr-slot__corner qr-slot__corner--tl"></span>
    <span class="qr-slot__corner qr-slot__corner--tr"></span>
    <span class="qr-slot__corner qr-slot__corner--bl"></span>
    <span class="qr-slot__corner qr-slot__corner--br"></span>
  </div>
  <p class="qr-slot__label">
    {alt ? (
      <>
        <span class="l10n" lang="fr-CH">{qr.coming}</span>
        <span class="l10n" lang="en">{alt.coming}</span>
      </>
    ) : qr.coming}
  </p>
</div>

<style>
  .qr-slot {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  /* The square the code will occupy - 30mm at the size it prints, roughly. */
  .qr-slot__frame {
    position: relative;
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: calc(var(--radius) / 2);
    background: rgb(255 255 255 / 0.04);
  }

  .qr-slot__corner {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--band-accent, var(--gold));
    opacity: 0.55;
  }

  .qr-slot__corner--tl { inset-block-start: 0; inset-inline-start: 0; border-inline-end: 0; border-block-end: 0; }
  .qr-slot__corner--tr { inset-block-start: 0; inset-inline-end: 0; border-inline-start: 0; border-block-end: 0; }
  .qr-slot__corner--bl { inset-block-end: 0; inset-inline-start: 0; border-inline-end: 0; border-block-start: 0; }
  .qr-slot__corner--br { inset-block-end: 0; inset-inline-end: 0; border-inline-start: 0; border-block-start: 0; }

  .qr-slot__label {
    margin: 0;
    max-width: 14ch;
    color: var(--band-muted, var(--muted-on-dark));
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.5;
  }
</style>
