---
/**
 * Sticky masthead: brand, primary navigation, language switcher.
 *
 * The mobile menu is a native <details> disclosure, so it needs no JavaScript
 * and stays keyboard- and screen-reader-operable if scripts fail to load.
 */
import { Image } from 'astro:assets';
import { getContent, localeAlternates, localePath, type Locale } from '@/lib/i18n';
import { SECTION_ORDER } from '@/config/site';
import crest from '@/assets/logo/mhsv-crest.png';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '' } = Astro.props;
const c = getContent(locale);
const home = localePath('', locale);
const alternates = localeAlternates(path);

const anchorFor = (id: string) => SECTION_ORDER.find((s) => s.id === id)?.anchor ?? id;
// On sub-pages the in-page anchors have to point back at the home document.
const navHref = (id: string) => `${path === '' ? '' : home}#${anchorFor(id)}`;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={home}>
      <Image src={crest} alt="" width={36} height={40} loading="eager" densities={[1, 2]} />
      <span class="brand__name">{c.brand.name}</span>
      <span class="visually-hidden">— {c.brand.institutional}</span>
    </a>

    <nav class="nav-desktop" aria-label={c.ui.primaryNav}>
      <ul>
        {
          c.nav.items.map((item) => (
            <li>
              <a href={navHref(item.id)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <nav class="lang" aria-label={c.ui.languageNav}>
        <ul>
          {
            alternates.map((alt) => (
              <li>
                <a
                  href={alt.path}
                  hreflang={alt.hreflang}
                  lang={alt.hreflang}
                  aria-current={alt.locale === locale ? 'true' : undefined}
                >
                  <span class="visually-hidden">{alt.name}</span>
                  <span aria-hidden="true">{alt.nameShort}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <details class="nav-mobile">
        <summary aria-label={c.ui.openMenu}>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.75" fill="none" />
          </svg>
        </summary>
        <div class="nav-mobile__panel">
          <nav aria-label={c.ui.sectionIndex}>
            <ul>
              {
                c.nav.items.map((item) => (
                  <li>
                    <a href={navHref(item.id)}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-ink) 88%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid rgb(255 255 255 / 0.1);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 4rem;
  }

  @media (min-width: 24rem) {
    .site-header__inner {
      gap: 1rem;
    }
  }

  /* --- brand ------------------------------------------------------------ */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-bone);
    flex: 0 0 auto;
  }

  .brand :global(img) {
    width: 1.875rem;
    height: auto;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }

  /* At 320px the crest, four language codes and the menu button cannot all fit
     alongside the wordmark. The crest alone still identifies the site, and the
     full name remains in the <h1> immediately below. */
  @media (max-width: 22.5rem) {
    .brand__name {
      display: none;
    }
  }

  /* --- desktop nav ------------------------------------------------------ */
  .nav-desktop {
    display: none;
    flex: 1 1 auto;
    min-width: 0;
  }

  .nav-desktop ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    display: block;
    padding: 0.25rem 0;
    font-size: 0.875rem;
    color: var(--color-bone);
    text-decoration: none;
    border-block-end: 1px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .nav-desktop a:hover {
    color: var(--color-gold-bright);
    border-block-end-color: var(--color-gold);
  }

  /* --- actions ---------------------------------------------------------- */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
    flex: 0 0 auto;
  }

  .lang ul {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lang a {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Kept narrow so four codes fit at 320px; the 36px height keeps the target
       comfortable despite the width. */
    min-width: 1.75rem;
    min-height: 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #a5a5ac;
    text-decoration: none;
    border-radius: 2px;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .lang a:hover {
    color: var(--color-gold-bright);
  }

  .lang a[aria-current='true'] {
    color: var(--color-ink);
    background: var(--color-gold);
  }

  /* --- mobile menu ------------------------------------------------------ */
  .nav-mobile summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-bone);
    cursor: pointer;
    list-style: none;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 2px;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile[open] summary {
    border-color: var(--color-gold);
    color: var(--color-gold-bright);
  }

  .nav-mobile__panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--color-ink-raised);
    border-block-end: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .nav-mobile__panel ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
  }

  .nav-mobile__panel a {
    display: block;
    padding: 0.875rem clamp(1rem, 0.4rem + 3vw, 3.5rem);
    font-size: 1rem;
    color: var(--color-bone);
    text-decoration: none;
    border-block-end: 1px solid rgb(255 255 255 / 0.06);
  }

  .nav-mobile__panel a:hover {
    color: var(--color-gold-bright);
    background: rgb(255 255 255 / 0.04);
  }

  @media (min-width: 26rem) {
    .lang a {
      min-width: 2rem;
    }
  }

  @media (min-width: 62rem) {
    .nav-desktop {
      display: block;
    }

    .nav-mobile {
      display: none;
    }
  }
</style>
