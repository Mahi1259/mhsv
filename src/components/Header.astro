---
import { Image } from 'astro:assets';
import { getContent, localeAlternates, localePath, type Locale } from '@/lib/i18n';
import { SECTION_ORDER } from '@/config/site';
import crest from '@/assets/logo/mhsv-crest.png';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '' } = Astro.props;
const c = getContent(locale);
const home = localePath('', locale);
const alternates = localeAlternates(path);

const anchorFor = (id: string) => SECTION_ORDER.find((s) => s.id === id)?.anchor ?? id;
const navHref = (item: { id: string; href?: string }) =>
  item.href ? localePath(item.href, locale) : `${path === '' ? '' : home}#${anchorFor(item.id)}`;
---

<header class="site-header">
  <div class="site-header__shell">
    <a class="brand" href={home}>
      <Image src={crest} alt="" width={36} height={40} loading="eager" densities={[1, 2]} />
      <span class="brand__name notranslate" translate="no">{c.brand.name}</span>
      <span class="visually-hidden">, {c.brand.institutional}</span>
    </a>
    <details class="menu">
      <summary aria-label={c.ui.openMenu}>
        <span class="menu__bars" aria-hidden="true"></span>
      </summary>
    </details>
    <nav id="main-nav" aria-label={c.ui.primaryNav}>
      <ul>
        {
          c.nav.items.map((item) => (
            <li>
              <a href={navHref(item)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="lang notranslate" translate="no">
      <nav class="lang__switch" aria-label={c.ui.languageNav}>
        <ul>
          {
            alternates.map((alt) => (
              <li>
                <a
                  href={alt.path}
                  data-lang-link
                  data-base={alt.path}
                  hreflang={alt.hreflang}
                  lang={alt.hreflang}
                  aria-current={alt.locale === locale ? 'true' : undefined}
                >
                  <span class="visually-hidden">{alt.name}</span>
                  <span aria-hidden="true">{alt.nameShort}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
<style>
  .site-header {
    --nav-geo: 480ms var(--ease-out);
    --nav-skin: 380ms ease-out;

    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
  }

  .site-header__shell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 78rem;
    min-height: 4.25rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 0.5rem + 3.4vw, 4rem);
    background: color-mix(in srgb, var(--navy-deep) 94%, transparent);
    border-block-end: 1px solid var(--hairline);
  }

  @media (min-width: 24rem) {
    .site-header__shell {
      gap: 1rem;
    }
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--white);
    flex: 0 0 auto;
    transition: opacity 180ms var(--ease);
  }

  .brand:hover {
    opacity: 0.82;
  }

  .brand :global(img) {
    width: 1.875rem;
    height: auto;
  }

  .brand__name {
    margin-inline-start: 0.5rem;
    max-width: 7rem;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }

  @media (max-width: 22.5rem) {
    .brand__name {
      display: none;
    }
  }

  #main-nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #main-nav a {
    display: block;
    color: var(--white);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }

  #main-nav a:hover {
    color: var(--gold-soft);
  }

  @media (max-width: 61.999rem) {
    #main-nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--navy-raise);
      border-block-end: 1px solid var(--hairline);
      box-shadow: 0 20px 44px rgb(0 0 0 / 0.45);
      max-height: calc(100dvh - 4.25rem);
      overflow-y: auto;
    }

    .menu[open] ~ #main-nav {
      display: block;
    }

    #main-nav ul {
      flex-direction: column;
      padding-block: 0.5rem;
    }

    #main-nav a {
      padding: 0.875rem clamp(1rem, 0.4rem + 3vw, 3.5rem);
      font-size: 1rem;
      border-block-end: 1px solid var(--hairline-soft);
    }
  }

  @media (min-width: 62rem) {
    #main-nav {
      flex: 1 1 auto;
      min-width: 0;
    }

    #main-nav ul {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 1.25rem;
      font-size: 0.875rem;
    }

    #main-nav a {
      padding-block: 0.25rem;
      position: relative;
    }

    #main-nav a::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: -2px;
      height: 1px;
      background: var(--gold);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--dur-fast) var(--ease-out);
    }

    #main-nav a:hover::after {
      transform: scaleX(1);
    }

    .menu {
      display: none;
    }
  }

  .menu {
    order: 3;
    margin-inline-start: auto;
    flex: 0 0 auto;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--hairline-strong);
    border-radius: 3px;
    color: var(--white);
    transition: border-color 180ms var(--ease), color 180ms var(--ease);
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] summary {
    border-color: var(--gold);
    color: var(--gold-soft);
  }

  .menu__bars,
  .menu__bars::before,
  .menu__bars::after {
    display: block;
    width: 1.125rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 220ms var(--ease), opacity 160ms var(--ease);
  }

  .menu__bars {
    position: relative;
  }

  .menu__bars::before,
  .menu__bars::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .menu__bars::before {
    top: -6px;
  }

  .menu__bars::after {
    top: 6px;
  }

  .menu[open] .menu__bars {
    background: transparent;
  }

  .menu[open] .menu__bars::before {
    transform: translateY(6px) rotate(45deg);
  }

  .menu[open] .menu__bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .lang {
    order: 2;
    flex: 0 0 auto;
    margin-inline-start: auto;
  }

  @media (min-width: 62rem) {
    .lang {
      margin-inline-start: 0;
    }
  }

  .lang ul {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lang a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    min-height: 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--muted-on-dark);
    text-decoration: none;
    border-radius: 3px;
    transition: color 180ms var(--ease), background-color 180ms var(--ease);
  }

  .lang a:hover {
    color: var(--gold-soft);
  }

  .lang a[aria-current='true'] {
    color: var(--navy-deep);
    background: var(--gold);
  }

  @media (min-width: 26rem) {
    .lang a {
      min-width: 2rem;
    }
  }

  @media (min-width: 62rem) {
    .site-header {
      transition: padding var(--nav-geo);
    }

    .site-header__shell {
      border: 1px solid transparent;
      border-radius: 0;
      background: transparent;
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
      box-shadow: 0 0 0 0 rgb(0 0 0 / 0);
      transition:
        max-width var(--nav-geo),
        min-height var(--nav-geo),
        padding var(--nav-geo),
        border-radius var(--nav-geo),
        background var(--nav-skin),
        border-color var(--nav-skin),
        box-shadow var(--nav-skin),
        backdrop-filter var(--nav-skin);
    }

    .site-header.is-animating .site-header__shell {
      will-change: max-width, padding, border-radius;
    }

    :global(html.is-booting) .site-header,
    :global(html.is-booting) .site-header__shell,
    :global(html.is-booting) .brand__name,
    :global(html.is-booting) .brand img,
    :global(html.is-booting) #main-nav ul {
      transition: none;
    }

    .brand__name,
    .brand :global(img),
    #main-nav ul {
      transition:
        max-width var(--nav-geo),
        margin var(--nav-geo),
        width var(--nav-geo),
        gap var(--nav-geo),
        font-size var(--nav-geo),
        opacity var(--nav-skin);
    }

    .site-header.is-shrunk {
      padding: 0.85rem 1rem 0;
    }

    .site-header.is-shrunk .site-header__shell {
      max-width: 61rem;
      min-height: 3.25rem;
      padding-inline: 1.4rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--navy-deep) 82%, transparent);
      border-color: color-mix(in srgb, var(--gold) 18%, transparent);
      backdrop-filter: blur(18px) saturate(140%);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      box-shadow:
        0 8px 32px rgb(0 0 0 / 0.3),
        0 1px 0 rgb(255 255 255 / 0.05) inset;
    }

    .site-header.is-shrunk .brand__name {
      max-width: 0;
      margin-inline-start: 0;
      opacity: 0;
    }

    .site-header.is-shrunk .brand :global(img) {
      width: 1.5625rem;
    }

    .site-header.is-shrunk #main-nav ul {
      gap: 0.25rem 1.15rem;
      font-size: 0.86rem;
    }

    .site-header.is-shrunk .lang a {
      min-width: 1.75rem;
      min-height: 1.875rem;
      font-size: 0.6875rem;
    }

    .site-header.is-shrunk .lang ul {
      gap: 0.0625rem;
    }
  }
</style>
