---
/**
 * Reserved 16:9 block for the presentation video, which does not exist yet.
 *
 * `role="img"` with a label rather than a bare decorative box: the reservation
 * is information - a reader should be told a video is coming, not shown an
 * empty rectangle. It is not a button and not a link, because there is nothing
 * yet to play, and an inert control is worse than none.
 */
import { getContent, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
---

<div class="video-placeholder" role="img" aria-label={c.video.ariaLabel}>
  <div class="video-placeholder__inner">
    <svg viewBox="0 0 24 24" width="44" height="44" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1" />
      <path d="M10 8.5v7l6-3.5z" fill="currentColor" />
    </svg>
    <p class="video-placeholder__label">{c.video.coming}</p>
  </div>
</div>

<style>
  /*
   * A mirror, not a flat panel.
   *
   * Three things make it read as polished glass rather than a coloured box,
   * and it needs all three: light passes THROUGH it (backdrop blur, so the
   * page's washes move behind it), light catches its top edge (a 1px inset
   * highlight, the same detail the masthead pill uses), and light runs ACROSS
   * it (a diagonal specular band). One alone reads as a gradient.
   */
  .video-placeholder {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--gold) 22%, transparent);
    border-radius: var(--radius);
    background:
      linear-gradient(
        152deg,
        rgb(255 255 255 / 0.08) 0%,
        rgb(255 255 255 / 0.02) 30%,
        rgb(255 255 255 / 0) 52%
      ),
      color-mix(in srgb, var(--navy-raise) 88%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.1) inset,
      0 -1px 0 rgb(0 0 0 / 0.25) inset,
      0 26px 60px -34px rgb(0 0 0 / 0.65);
  }

  /*
   * The specular band. Peak held at 12%: composited on navy-raise that is the
   * lightest the surface ever gets behind the label, and the pairing is
   * asserted in scripts/check-contrast.mjs so it cannot drift brighter
   * without the build noticing.
   */
  .video-placeholder::before {
    content: '';
    position: absolute;
    inset: -30% -12%;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 38%,
      rgb(255 255 255 / 0.12) 49%,
      transparent 61%
    );
  }

  .video-placeholder__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    padding: 1rem;
    /*
     * gold-soft, not gold. Plain gold is 5.12:1 on the unlit surface but drops
     * to 4.06:1 where the sheen crosses it - below AA. gold-soft holds 5.27:1
     * at the same point.
     */
    color: var(--gold-soft);
  }

  .video-placeholder__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
