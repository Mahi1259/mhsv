---
/**
 * Site footer.
 *
 * Deliberately short. It previously repeated all 20 section links and the full
 * contact block, so the page ended with a second copy of its own navigation
 * and a third copy of the contact details. Now: five section links, the legal
 * links, and one summary line.
 *
 * The association / legal-status block stays withheld unless
 * PUBLIC_SHOW_LEGAL_STATUS is true.
 */
import { getContent, localePath, type Locale } from '@/lib/i18n';
import { SECTION_ORDER, FOOTER_LINKS, SHOW_LEGAL_STATUS } from '@/config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const home = localePath('', locale);

// Labels come from the navigation, not the section titles: the content pack
// writes its headings in capitals ("WHO WE ARE", "CONTACT & LEGAL"), which
// reads badly in a short link list next to the sentence-case authored ones.
const sections = c.sections as Record<string, { title: string }>;
const navLabels = new Map(c.nav.items.map((item) => [item.id, item.label]));
const links = FOOTER_LINKS.map((id) => ({
  anchor: SECTION_ORDER.find((s) => s.id === id)!.anchor,
  title: navLabels.get(id) ?? sections[id].title,
}));

const year = new Date().getFullYear();
---

<footer class="band band--navy-deep site-footer">
  <div class="shell">
    <p class="site-footer__baseline">{c.brand.baseline}</p>

    <div class="site-footer__grid">
      <nav class="site-footer__col" aria-label={c.ui.sectionIndex}>
        <h2 class="mono-label site-footer__title">{c.footer.navTitle}</h2>
        <ul class="site-footer__links">
          {
            links.map((item) => (
              <li>
                <a href={`${home}#${item.anchor}`}>{item.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="mono-label site-footer__title">{c.footer.legalTitle}</h2>
        <ul class="site-footer__links">
          <li><a href={localePath('privacy/', locale)}>{c.footer.privacyLink}</a></li>
          {
            SHOW_LEGAL_STATUS && (
              <li>
                <a href={localePath('legal-notice/', locale)}>{c.footer.legalLink}</a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    {
      /* Specified by the content pack, withheld by a later client instruction
         pending validation of the statutes. */
      SHOW_LEGAL_STATUS && (
        <div class="site-footer__legal">
          {c.sections.contact.legalFooter.map((line) => (
            <span>{line}</span>
          ))}
        </div>
      )
    }

    <div class="site-footer__base">
      <p>{c.footer.summary}</p>
      <p>© {year} {c.brand.name}. {c.footer.copyright} {c.footer.trademarkNote}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem);
  }

  .site-footer__baseline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    color: var(--gold);
    max-width: 24ch;
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer__col {
    min-width: 0;
  }

  .site-footer__title {
    color: var(--muted-on-dark);
    margin: 0 0 1rem;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    overflow-wrap: anywhere;
  }

  .site-footer__links a {
    display: inline-block;
    padding-block: 0.1875rem;
    color: var(--white);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 180ms var(--ease);
  }

  .site-footer__links a:hover {
    color: var(--gold-soft);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--muted-on-dark);
    font-size: 0.8125rem;
  }

  .site-footer__base {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--muted-on-dark);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .site-footer__base p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 14rem));
      gap: 3rem;
    }
  }
</style>
