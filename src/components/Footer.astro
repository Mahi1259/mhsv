---
/**
 * Site footer: full section index, contact details, legal links.
 *
 * The association / legal-status block is withheld unless
 * PUBLIC_SHOW_LEGAL_STATUS is true — see BLOCKERS.md #1.
 */
import { getContent, localePath, type Locale } from '@/lib/i18n';
import { SECTION_ORDER, SHOW_LEGAL_STATUS } from '@/config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const home = localePath('', locale);

// All 21 sections, so every anchor is reachable without the primary nav.
const index = SECTION_ORDER.filter((s) => s.id !== 'hero').map((s) => ({
  anchor: s.anchor,
  title: (c.sections as Record<string, { title: string; num: string }>)[s.id].title,
  num: (c.sections as Record<string, { title: string; num: string }>)[s.id].num,
}));

const contact = c.sections.contact;
const year = new Date().getFullYear();
---

<footer class="band band-ink site-footer">
  <div class="shell">
    {/* The §21 tagline already closes the contact band directly above, so the
        footer carries the baseline instead of repeating it. */}
    <p class="site-footer__tagline">{c.brand.baseline}</p>

    <div class="site-footer__grid">
      <nav class="site-footer__col site-footer__col--index" aria-label={c.ui.sectionIndex}>
        <h2 class="mono-label site-footer__title">{c.footer.navTitle}</h2>
        <ul class="site-footer__index">
          {
            index.map((item) => (
              <li>
                <a href={`${home}#${item.anchor}`}>
                  <span class="site-footer__num">{item.num}</span>
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="mono-label site-footer__title">{c.footer.contactTitle}</h2>
        <address class="site-footer__address">
          <span>{contact.institutional}</span>
          <span>{contact.place}</span>
          <a class="link" href={`tel:${contact.phone.replace(/\s+/g, '')}`}>{contact.phone}</a>
          <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>
        </address>
      </div>

      <div class="site-footer__col">
        <h2 class="mono-label site-footer__title">{c.footer.legalTitle}</h2>
        <ul class="site-footer__links">
          <li><a class="link" href={localePath('privacy/', locale)}>{c.footer.privacyLink}</a></li>
          {
            SHOW_LEGAL_STATUS && (
              <li>
                <a class="link" href={localePath('legal-notice/', locale)}>
                  {c.footer.legalLink}
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    {
      /* BLOCKER #1 — the content pack specifies this block, a later client
         instruction withholds it pending validation of the statutes. */
      SHOW_LEGAL_STATUS && (
        <div class="site-footer__legal">
          {contact.legalFooter.map((line) => (
            <span>{line}</span>
          ))}
        </div>
      )
    }

    <hr class="rule site-footer__rule" />

    <div class="site-footer__base">
      <p>© {year} {c.brand.name}. {c.footer.copyright}</p>
      <p>{c.footer.trademarkNote}</p>
      <p><a class="link" href="#top">{c.ui.backToTop}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
    border-block-start: 1px solid var(--band-rule);
  }

  .site-footer__tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    color: var(--band-accent);
    max-width: 24ch;
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  /* Grid items default to min-width:auto, so a long unbreakable string —
     "Datenschutzerklärung", or the contact address — forces its track wider
     than its share and pushes the page sideways. */
  .site-footer__col {
    min-width: 0;
  }

  .site-footer__title {
    color: var(--band-muted);
    margin: 0 0 1rem;
  }

  .site-footer__index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
  }

  .site-footer__index a {
    display: flex;
    gap: 0.625rem;
    align-items: baseline;
    color: var(--band-fg);
    text-decoration: none;
    font-size: 0.9375rem;
    /* Keeps the row at a 24px target without opening up the list. */
    padding-block: 0.25rem;
  }

  .site-footer__index a:hover {
    color: var(--band-accent);
  }

  .site-footer__num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--band-muted);
    flex: 0 0 auto;
  }

  .site-footer__address {
    display: grid;
    gap: 0.375rem;
    font-style: normal;
    color: var(--band-muted);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--band-rule);
    color: var(--band-muted);
    font-size: 0.8125rem;
  }

  .site-footer__rule {
    margin-block: 2.5rem 1.5rem;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    color: var(--band-muted);
    font-size: 0.8125rem;
  }

  .site-footer__base p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }

    .site-footer__index {
      grid-template-columns: 1fr 1fr;
      gap: 0.375rem 1.5rem;
    }
  }
</style>
