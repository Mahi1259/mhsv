---
import { getContent, legalPath, type Locale } from '@/lib/i18n';
import { LEGAL_PAGE_IDS, SHOW_LEGAL_STATUS } from '@/config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);

const year = new Date().getFullYear();
---

<footer class="band site-footer">
  <div class="shell">
    <p class="site-footer__baseline">{c.brand.baseline}</p>
    <div class="site-footer__col">
      <h2 class="mono-label site-footer__title">{c.footer.legalTitle}</h2>
      <ul class="site-footer__links">
        {
          LEGAL_PAGE_IDS.map((page) => (
            <li>
              <a href={legalPath(page, locale)}>{c.legalPages.titles[page]}</a>
            </li>
          ))
        }
        <li><a href={legalPath('photoCredits', locale)}>{c.photoCredits.title}</a></li>
        <li>
          <button class="site-footer__cookies" type="button" data-cookie-reopen hidden>
            {c.cookies.settings}
          </button>
        </li>
      </ul>
    </div>
    {
      SHOW_LEGAL_STATUS && (
        <div class="site-footer__legal">
          {c.sections.contact.legalFooter.map((line) => (
            <span>{line}</span>
          ))}
        </div>
      )
    }

    <div class="site-footer__base">
      <p>{c.footer.summary}</p>
      <p>© {year} {c.brand.name}. {c.footer.copyright}</p>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem);
  }

  .site-footer__baseline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    color: var(--gold);
    max-width: 24ch;
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .site-footer__col {
    min-width: 0;
  }

  .site-footer__title {
    color: var(--muted-on-dark);
    margin: 0 0 1rem;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    overflow-wrap: anywhere;
  }

  .site-footer__links a {
    display: inline-block;
    padding-block: 0.1875rem;
    color: var(--white);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 180ms var(--ease);
  }

  .site-footer__links a:hover,
  .site-footer__cookies:hover {
    color: var(--gold-soft);
  }

  .site-footer__cookies {
    display: inline-block;
    padding: 0.1875rem 0;
    border: 0;
    background: none;
    color: var(--white);
    font: inherit;
    font-size: 0.9375rem;
    text-align: start;
    cursor: pointer;
    transition: color 180ms var(--ease);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--muted-on-dark);
    font-size: 0.8125rem;
  }

  .site-footer__base {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--muted-on-dark);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .site-footer__base p {
    margin: 0;
  }
</style>
