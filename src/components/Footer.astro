---
/**
 * Site footer.
 *
 * Deliberately short. It repeated all 20 section links and the full contact
 * block at one point, so the page ended with a second copy of its own
 * navigation and a third copy of the contact details. The section list has
 * since gone too: the masthead is fixed and carries every one of them, so
 * repeating five of them at the bottom was a third navigation, not a service.
 *
 * What is left is the pair of legal pages, which are the only things a reader
 * cannot reach from the masthead.
 *
 * The association / legal-status block stays withheld unless
 * PUBLIC_SHOW_LEGAL_STATUS is true.
 */
import { getContent, legalPath, type Locale } from '@/lib/i18n';
import { LEGAL_PAGE_IDS, SHOW_LEGAL_STATUS } from '@/config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);

const year = new Date().getFullYear();
---

<footer class="band site-footer">
  <div class="shell">
    <p class="site-footer__baseline">{c.brand.baseline}</p>

    <div class="site-footer__col">
      <h2 class="mono-label site-footer__title">{c.footer.legalTitle}</h2>
      {/* All four legal pages, always present. Each says its final wording is
          with MHSV®'s counsel rather than the link disappearing and leaving a
          reader with nowhere to look. */}
      <ul class="site-footer__links">
        {
          LEGAL_PAGE_IDS.map((page) => (
            <li>
              <a href={legalPath(page, locale)}>{c.legalPages.titles[page]}</a>
            </li>
          ))
        }
        <li><a href={legalPath('photoCredits', locale)}>{c.photoCredits.title}</a></li>
      </ul>
    </div>

    {
      /* Specified by the content pack, withheld by a later client instruction
         pending validation of the statutes. */
      SHOW_LEGAL_STATUS && (
        <div class="site-footer__legal">
          {c.sections.contact.legalFooter.map((line) => (
            <span>{line}</span>
          ))}
        </div>
      )
    }

    <div class="site-footer__base">
      <p>{c.footer.summary}</p>
      <p>© {year} {c.brand.name}. {c.footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem);
  }

  .site-footer__baseline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    color: var(--gold);
    max-width: 24ch;
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .site-footer__col {
    min-width: 0;
  }

  .site-footer__title {
    color: var(--muted-on-dark);
    margin: 0 0 1rem;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    overflow-wrap: anywhere;
  }

  .site-footer__links a {
    display: inline-block;
    padding-block: 0.1875rem;
    color: var(--white);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 180ms var(--ease);
  }

  .site-footer__links a:hover {
    color: var(--gold-soft);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--muted-on-dark);
    font-size: 0.8125rem;
  }

  .site-footer__base {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--muted-on-dark);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .site-footer__base p {
    margin: 0;
  }

</style>
