---
/**
 * §06 — Methodology & MITIPS®: the six pillars.
 *
 * Descriptions are always rendered rather than revealed on hover, so the
 * content is available to keyboard and screen-reader users and to anyone on a
 * touch device. Hover/focus only changes emphasis.
 *
 * Pillar descriptions are authored placeholders — BLOCKERS.md #7. The pack
 * supplies only the six labels, and the detailed internal protocols are
 * explicitly not for publication.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { BandTone } from '@/config/site';

interface Props {
  locale: Locale;
  tone: BandTone;
}

const { locale, tone } = Astro.props;
const s = getContent(locale).sections.method;
const pillars = s.pillars.map((p, i) => ({ ...p, note: s.pillarNotes[i] }));
const acronym = s.pillars.map((p) => p.letter).join('');
---

<Band locale={locale} anchor={s.anchor} num={s.num} title={s.title} tone={tone} lead={s.lead}>
  <h3 class="method__subtitle">
    <span class="method__acronym" aria-hidden="true">{acronym}®</span>
    {s.pillarsTitle}
  </h3>

  <ul class="pillars">
    {
      pillars.map((pillar) => (
        <li class="pillar">
          <span class="pillar__hex" aria-hidden="true">
            <span class="pillar__letter">{pillar.letter}</span>
          </span>
          <h4 class="pillar__name">
            <span class="visually-hidden">{pillar.letter} — </span>
            {pillar.name}
          </h4>
          <p class="pillar__note">{pillar.note}</p>
        </li>
      ))
    }
  </ul>

  <p class="method__disclaimer">{s.pillarNotesDisclaimer}</p>
  <p class="prose-body method__note">{s.note}</p>
</Band>

<style>
  .method__subtitle {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--text-h3);
    margin: 0 0 1.75rem;
  }

  .method__acronym {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.35em;
    color: var(--band-accent);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pillar {
    padding: 1.25rem 1rem;
    text-align: center;
    background: var(--band-raised);
    border: 1px solid var(--band-rule);
    border-radius: var(--radius-card);
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .pillar:hover,
  .pillar:focus-within {
    border-color: var(--band-accent);
    transform: translateY(-2px);
  }

  .pillar__hex {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.625rem;
    margin-inline: auto;
    background: var(--band-accent);
    /* Hexagon suits the crest; a rounded square is a fine fallback where
       clip-path is unsupported. */
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  }

  .pillar__letter {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--band-bg);
  }

  .pillar__name {
    margin: 0.875rem 0 0.375rem;
    font-size: 0.9375rem;
    line-height: 1.25;
    /* German pillar names are the longest; hyphenate rather than overflow. */
    hyphens: auto;
  }

  .pillar__note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--band-muted);
  }

  .method__disclaimer {
    margin-block-start: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--band-muted);
  }

  .method__note {
    margin-block-start: 2rem;
  }

  @media (min-width: 40rem) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .pillars {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
