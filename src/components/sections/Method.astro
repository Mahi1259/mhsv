---
/**
 * Methodology & MITIPS® - feature type. The signature element.
 *
 * Six hexagons; selecting one expands its description. Built as a real
 * tablist: arrow keys move between pillars, Home/End jump to the ends, and the
 * panel is associated with its tab. With JavaScript off every description is
 * rendered in sequence instead, so nothing is lost.
 *
 * Pillar descriptions are provisional - the pack supplies only the six labels,
 * and the detailed internal protocols are explicitly not for publication.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.method;
const pillars = s.pillars.map((p, i) => ({ ...p, note: s.pillarNotes[i], index: i }));
const acronym = s.pillars.map((p) => p.letter).join('');
---

<Band
  locale={locale}
  anchor={s.anchor}
  title={s.title}
  type={type}
 
  lead={s.lead}
>
  <div class="method">
    <div class="method__sticky" data-reveal-x>
      <p class="method__acronym" aria-hidden="true">{acronym}<span>®</span></p>
      <h3 class="method__subtitle">{s.pillarsTitle}</h3>
      {/* Decorative echo of whichever pillar is in view - the pillar's own
          heading is what assistive technology reads. */}
      <p class="method__active" data-active-pillar aria-hidden="true">{pillars[0].name}</p>
    </div>

    <ol class="pillars" data-pillars>
      {
        pillars.map((pillar) => (
          <li class="pillar" data-pillar-name={pillar.name}>
            <span class="pillar__hex" aria-hidden="true">
              <span class="pillar__letter">{pillar.letter}</span>
            </span>
            <div class="pillar__body">
              <h4 class="pillar__name">
                <span class="visually-hidden">{pillar.letter}: </span>
                {pillar.name}
              </h4>
              <p class="pillar__note">{pillar.note}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="prose-body method__note">{s.note}</p>
</Band>

<script>
  /**
   * Crossfade the pinned label to whichever pillar is currently in view.
   *
   * Purely decorative: every pillar and its description is in the document and
   * readable with this script absent, so nothing depends on it. The label is
   * aria-hidden, which is why swapping its text is not an accessibility event.
   */
  const root = document.querySelector<HTMLElement>('[data-pillars]');
  const label = document.querySelector<HTMLElement>('[data-active-pillar]');

  if (root && label && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const pillars = Array.from(root.querySelectorAll<HTMLElement>('[data-pillar-name]'));

    const setLabel = (name: string) => {
      if (label.textContent === name) return;
      label.classList.add('is-swapping');
      window.setTimeout(() => {
        label.textContent = name;
        label.classList.remove('is-swapping');
      }, 160);
    };

    const io = new IntersectionObserver(
      (entries) => {
        // The pillar nearest the top of the reading area wins.
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) setLabel((visible.target as HTMLElement).dataset.pillarName ?? '');
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: 0 },
    );

    pillars.forEach((el) => io.observe(el));
  }
</script>

<style>
  .method {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .method__acronym {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.25rem);
    font-weight: 500;
    letter-spacing: 0.24em;
    color: var(--band-accent);
    line-height: 1;
  }

  .method__acronym span {
    font-size: 0.5em;
    vertical-align: super;
    letter-spacing: 0;
  }

  .method__subtitle {
    margin: 0 0 1.25rem;
    font-size: var(--text-h3);
  }

  /* The pinned echo of the pillar currently being read. */
  .method__active {
    margin: 0 0 1.5rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--band-rule);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    color: var(--band-fg);
    opacity: 1;
    transition: opacity 160ms var(--ease-out);
  }

  .method__active.is-swapping {
    opacity: 0;
  }

  .method__disclaimer {
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--band-muted);
    max-width: 30ch;
  }

  /* --- pillars ---------------------------------------------------------- */
  .pillars {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .pillar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.125rem;
    align-items: start;
    padding: 1.25rem 1.25rem 1.25rem 0;
    border-block-start: 1px solid var(--band-rule);
  }

  .pillar:first-child {
    border-block-start: 0;
  }

  .pillar__hex {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3.375rem;
    flex: 0 0 auto;
    background: color-mix(in srgb, var(--band-accent) 20%, transparent);
    color: var(--band-accent);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .pillar:hover .pillar__hex {
    background: var(--band-accent);
    color: var(--band-bg);
  }

  .pillar__letter {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 900;
    line-height: 1;
  }

  .pillar__name {
    margin: 0 0 0.3125rem;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    hyphens: auto;
  }

  .pillar__note {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--band-muted);
  }

  .method__note {
    margin-block-start: 2.5rem;
  }

  /*
   * Two columns with a pinned left rail. Only above 900px - a sticky column in
   * a narrow viewport eats the screen, so below that it is ordinary flow.
   */
  @media (min-width: 56.25rem) {
    .method {
      grid-template-columns: 40% minmax(0, 1fr);
      gap: 4rem;
    }

    .method__sticky {
      position: sticky;
      top: 22vh;
      align-self: start;
      height: max-content;
    }

    .pillar {
      padding-block: 2rem;
    }
  }
</style>
