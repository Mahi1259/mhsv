---
/**
 * Hero — the only section with this weight.
 *
 * Carries the page's single <h1>. The tagline is three sentences in the
 * content pack ("Develop performance. Build the person. Prepare the future."),
 * so it is split and sequenced in ~300ms apart on load.
 *
 * The association / legal-status line is withheld behind SHOW_LEGAL_STATUS.
 */
import { Image } from 'astro:assets';
import { getContent, type Locale } from '@/lib/i18n';
import { SHOW_LEGAL_STATUS } from '@/config/site';
import logo from '@/assets/logo/mhsv-logo.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale);
const hero = c.sections.hero;

/** Split "A. B. C." into its sentences, keeping the full stops. */
const taglineLines = hero.tagline
  .split(/(?<=\.)\s+/)
  .map((line) => line.trim())
  .filter(Boolean);

/**
 * The pack gives four CTA labels in fixed order: discover / programmes /
 * request an assessment / become a partner.
 */
const CTA_TARGETS = ['#about', '#programmes', '#contact', '#contact'];
---

<section id="top" class="band band--ground band--hero hero" aria-labelledby="hero-title">
  <div class="shell hero__inner">
    <div class="hero__content">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__brand">{hero.brand}</span>
        <span class="hero__institutional">{hero.institutional}</span>
      </h1>

      {SHOW_LEGAL_STATUS && <p class="hero__legal mono-label">{hero.legalStatus}</p>}

      <p class="hero__baseline">{hero.baseline}</p>

      <p class="hero__tagline">
        {
          taglineLines.map((line, i) => (
            <span class="hero__taglineLine" style={`--i:${i}`}>
              {line}
            </span>
          ))
        }
      </p>

      <p class="lead hero__intro">{hero.intro}</p>

      <ul class="hero__ctas">
        {
          hero.ctas.map((label, i) => (
            <li>
              <a
                class:list={['btn', i === 0 ? 'btn--primary' : 'btn--ghost']}
                href={CTA_TARGETS[i]}
                data-magnetic={i === 0 ? '' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__mark">
      <Image
        src={logo}
        alt={c.seo.ogImageAlt}
        widths={[300, 440, 600]}
        sizes="(min-width: 62rem) 24rem, (min-width: 40rem) 18rem, 58vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;

    /*
     * Run the hero's ground up behind the masthead.
     *
     * The bar is fixed and translucent, and `body` reserves --header-h for it.
     * Left alone, that strip showed flat body navy while the hero's own wash
     * (below, anchored `at 10% 0%`) started at the hero's top edge — so the
     * page opened with a hard-edged rectangle straight across the top, right
     * behind the navbar. Cancelling the reservation here and taking the same
     * amount back as top padding puts the hero's box at y=0: the wash anchors
     * at the true top of the page, the ground is continuous under the bar, and
     * the hero's CONTENT does not move by a pixel.
     */
    margin-block-start: calc(-1 * var(--header-h));
    --band-pad-top: calc(var(--band-pad) + var(--header-h));

    /*
     * Fill the screen. The hero's box now spans the masthead too, so this is
     * the full viewport rather than the space below the bar — `100svh` alone
     * used to make it taller than the room it actually had, and the calls to
     * action fell past the fold on a laptop.
     *
     * Capped so a very tall window does not stretch it absurdly, and it is a
     * min-height, so short windows let the content grow rather than clip it.
     */
    min-height: min(100svh, calc(46rem + var(--header-h)));
    display: grid;
    align-items: center;
  }

  /* A single soft gold wash behind the mark, and a navy lift at the top. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(52rem 34rem at 78% 22%, rgb(212 175 55 / 0.14), transparent 66%),
      radial-gradient(40rem 30rem at 10% 0%, rgb(20 40 74 / 0.85), transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 5vw, 4.5rem);
    align-items: center;
  }

  .hero__title {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .hero__brand {
    display: block;
    font-size: var(--text-hero);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .hero__institutional {
    display: block;
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 0.88rem + 0.85vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--muted-on-dark);
    max-width: 22ch;
  }

  .hero__legal {
    margin-block-start: 1.25rem;
    color: var(--muted-on-dark);
  }

  .hero__baseline {
    margin-block-start: 1.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.125rem, 0.92rem + 0.95vw, 1.75rem);
    letter-spacing: -0.02em;
    color: var(--gold-soft);
  }

  .hero__tagline {
    display: grid;
    gap: 0.125rem;
    margin-block-start: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white);
  }

  /* Sequenced in on load, ~300ms apart. */
  .hero__taglineLine {
    opacity: 0;
    transform: translateY(8px);
    animation: hero-line 620ms var(--ease) forwards;
    animation-delay: calc(240ms + var(--i) * 300ms);
  }

  @keyframes hero-line {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__intro {
    margin-block-start: 1.75rem;
    color: var(--muted-on-dark);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .hero__mark {
    justify-self: center;
    max-width: 17rem;
    width: 100%;
  }

  .hero__mark :global(img) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 24px 48px rgb(0 0 0 / 0.5));
  }

  @media (min-width: 62rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }

    .hero__mark {
      justify-self: end;
      max-width: 24rem;
    }
  }

  @media (max-width: 24rem) {
    .hero__mark {
      max-width: 13rem;
    }
  }

  /* No entrance animation when motion is reduced — the lines are simply there. */
  @media (prefers-reduced-motion: reduce) {
    .hero__taglineLine {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
