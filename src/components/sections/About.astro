---
/**
 * Who we are - statement type.
 *
 * The pack's opening sentence names "MHSV Association" and states the legal
 * form, which the client instruction withholds pending the lawyer. While
 * SHOW_LEGAL_STATUS is off, a neutral authored sentence opens instead.
 */
import Band from '@/components/Band.astro';
import SectionImage from '@/components/SectionImage.astro';
import { getContent, type Locale } from '@/lib/i18n';
import { SHOW_LEGAL_STATUS, type SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.about;
const lead = SHOW_LEGAL_STATUS ? s.lead : s.leadNoLegalStatus;
---

<Band locale={locale} anchor={s.anchor} title={s.title} titleLines={s.titleLines} type={type}>
  <p class="statement-lead">{lead}</p>
  <div class="prose-body about__body">
    {s.paragraphs.map((text) => <p>{text}</p>)}
  </div>

  <SectionImage locale={locale} slot="about" eager />
</Band>

<style>
  .statement-lead {
    margin: 0 0 2.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1875rem, 1rem + 0.9vw, 1.625rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    max-width: 34ch;
    color: var(--band-fg);
  }

  .about__body {
    font-size: 1.0625rem;
  }
</style>
