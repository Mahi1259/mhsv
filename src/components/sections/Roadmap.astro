---
/**
 * Coming soon / roadmap — grid type.
 *
 * Presented as a roadmap, never as operating services.
 *
 * This section also carries the status legend, explained ONCE for the whole
 * page. The badges on the six forward-looking sections used to repeat the full
 * definition each time, which put the same sentence six times down the page.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import { capitalizeFirst } from '@/lib/text';
import { STATUS_KEYS, type Surface, type SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
  surface: Surface;
}

const { locale, type, surface } = Astro.props;
const c = getContent(locale);
const s = c.sections.roadmap;
const items = s.items.map((item) => capitalizeFirst(item, locale));
---

<Band
  locale={locale}
  anchor={s.anchor}
  title={s.title}
  type={type}
  surface={surface}
  lead={s.lead}
  status={s.status}
>
  <ul class="roadmap" data-stagger data-rows>
    {
      items.map((item) => (
        <li class="roadmap__item row">
          <span class="roadmap__marker" aria-hidden="true" />
          <span class="row__label">{item}</span>
        </li>
      ))
    }
  </ul>

  <aside class="legend">
    <h3 class="mono-label legend__title">{c.status.legendTitle}</h3>
    <p class="legend__intro">{c.status.legendIntro}</p>
    <dl class="legend__list">
      {
        STATUS_KEYS.map((key) => (
          <div class:list={['legend__row', `legend__row--${key}`]}>
            <dt>
              <span class="legend__dot" aria-hidden="true" />
              {c.status.items[key].label}
            </dt>
            <dd>{c.status.items[key].description}</dd>
          </div>
        ))
      }
    </dl>
  </aside>
</Band>

<style>
  .roadmap {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .roadmap__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9375rem 1.125rem;
    background: var(--band-raised);
    border: 1px dashed var(--band-rule);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .roadmap__marker {
    width: 0.375rem;
    height: 0.375rem;
    flex: 0 0 auto;
    border: 1px solid var(--band-accent);
    border-radius: 50%;
  }

  /* --- legend ----------------------------------------------------------- */
  .legend {
    margin-block-start: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-block-start: 1.75rem;
    border-block-start: 1px solid var(--band-rule);
  }

  .legend__title {
    margin: 0 0 0.5rem;
    color: var(--band-accent);
  }

  .legend__intro {
    margin: 0 0 1.25rem;
    color: var(--band-muted);
    font-size: 0.875rem;
  }

  .legend__list {
    display: grid;
    gap: 0.625rem 2rem;
    margin: 0;
  }

  .legend__row {
    display: grid;
    gap: 0.125rem;
  }

  .legend__row dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .legend__row dd {
    margin: 0;
    padding-inline-start: 1rem;
    color: var(--band-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .legend__dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--status-accent, var(--band-accent));
    flex: 0 0 auto;
  }

  .legend__row--active {
    --status-accent: #4f9d69;
  }

  .legend__row--pilot {
    --status-accent: #5b8db8;
  }

  .legend__row--partnership {
    --status-accent: #a1789e;
  }

  .legend__row--future {
    --status-accent: var(--band-muted);
  }

  @media (min-width: 40rem) {
    .roadmap {
      grid-template-columns: repeat(2, 1fr);
    }

    .legend__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .roadmap {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
