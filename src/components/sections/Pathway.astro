---
/**
 * The MHSV® pathway - feature type.
 *
 * Numbering is kept: these are six genuine steps and the order is the meaning.
 * The connecting line draws itself as the section scrolls into view (a CSS
 * scale transform driven by one class, so reduced-motion collapses it to
 * "already drawn").
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.pathway;
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type}>
  <div class="flow" data-flow>
    <span class="flow__line" aria-hidden="true"></span>
    <ol class="flow__list">
      {
        s.steps.map((step, i) => (
          <li class="flow__step" style={`--i:${i}`}>
            <span class="flow__marker" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="flow__label">
              <span class="visually-hidden">{s.stepLabel} {i + 1}: </span>
              {step}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</Band>

<script>
  // Draw the line once, when the flow reaches the viewport.
  const flows = document.querySelectorAll<HTMLElement>('[data-flow]');
  if (flows.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-drawn');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.25 },
    );
    flows.forEach((el) => io.observe(el));
  }
</script>

<style>
  .flow {
    position: relative;
  }

  .flow__list {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    z-index: 1;
  }

  .flow__step {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .flow__marker {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    background: var(--band-bg);
    border: 1px solid var(--band-accent);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--band-accent);
  }

  .flow__label {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    hyphens: auto;
  }

  /* Vertical rule on narrow screens. */
  .flow__line {
    position: absolute;
    left: 1.25rem;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 1px;
    background: var(--band-rule);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1100ms var(--ease);
  }

  .flow.is-drawn .flow__line {
    transform: scaleY(1);
  }

  .pathway__note {
    margin-block-start: 2.5rem;
  }

  @media (min-width: 64rem) {
    .flow__list {
      grid-template-columns: repeat(6, 1fr);
      gap: 1.25rem;
    }

    .flow__step {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
    }

    /* Horizontal rule threading the markers. */
    .flow__line {
      left: 0;
      right: 0;
      top: 1.25rem;
      bottom: auto;
      width: auto;
      height: 1px;
      transform: scaleX(0);
      transform-origin: left;
    }

    .flow.is-drawn .flow__line {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__line {
      transform: none !important;
    }
  }
</style>
