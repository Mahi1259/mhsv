---
/**
 * §08 — The MHSV® pathway: a six-step process flow.
 *
 * Ordered list, so the sequence survives without CSS. The connector arrows are
 * decorative and hidden from assistive technology.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { BandTone } from '@/config/site';

interface Props {
  locale: Locale;
  tone: BandTone;
}

const { locale, tone } = Astro.props;
const s = getContent(locale).sections.pathway;
---

<Band locale={locale} anchor={s.anchor} num={s.num} title={s.title} tone={tone}>
  <ol class="flow">
    {
      s.steps.map((step, i) => (
        <li class="flow__step">
          <span class="flow__marker" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="flow__label">
            <span class="visually-hidden">{s.stepLabel} {i + 1} — </span>
            {step}
          </span>
        </li>
      ))
    }
  </ol>
  <p class="prose-body pathway__note">{s.note}</p>
</Band>

<style>
  .flow {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .flow__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
    background: var(--band-raised);
    border: 1px solid var(--band-rule);
    border-radius: var(--radius-card);
  }

  .flow__marker {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border: 1px solid var(--band-accent);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--band-accent);
  }

  .flow__label {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    hyphens: auto;
  }

  .pathway__note {
    margin-block-start: 2rem;
  }

  @media (min-width: 48rem) {
    .flow {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem 1.75rem;
    }

    .flow__step {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 1.25rem;
    }

    /* Connector between steps within a row. */
    .flow__step:not(:nth-child(3n))::after {
      content: '';
      position: absolute;
      inset-inline-end: -1.375rem;
      inset-block-start: 50%;
      width: 1rem;
      height: 1px;
      background: var(--band-rule);
    }
  }

  @media (min-width: 64rem) {
    .flow {
      grid-template-columns: repeat(6, 1fr);
      gap: 1.5rem 1.25rem;
    }

    .flow__step:not(:nth-child(3n))::after {
      display: none;
    }

    .flow__step:not(:last-child)::after {
      content: '';
      display: block;
      position: absolute;
      inset-inline-end: -0.9375rem;
      inset-block-start: 2.25rem;
      width: 0.625rem;
      height: 1px;
      background: var(--band-rule);
    }
  }
</style>
