---
/**
 * §16 — Organisation & team.
 *
 * Hard constraints honoured here:
 *   - No photos in Phase 1. Name + role + MHSV® email only.
 *   - Only the roles listed in §16 of the pack. No governance titles beyond
 *     them, no historical org charts.
 *   - Where a mailbox does not exist yet (BLOCKERS.md #3) the role is shown
 *     without an address and marked pending, rather than inventing one.
 *
 * The card list is driven entirely by the content JSON, so adding a member
 * after institutional validation is a content edit, not a code change.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { BandTone } from '@/config/site';

interface Props {
  locale: Locale;
  tone: BandTone;
}

const { locale, tone } = Astro.props;
const s = getContent(locale).sections.team;
---

<Band locale={locale} anchor={s.anchor} num={s.num} title={s.title} tone={tone} lead={s.lead}>
  <ul class="team">
    {
      s.members.map((member) => (
        <li class="team__card">
          <h3 class="team__name">{member.name}</h3>
          <p class="team__role">{member.role}</p>
          {member.email ? (
            <a class="link team__email" href={`mailto:${member.email}`}>
              {member.email}
            </a>
          ) : (
            <p class="team__pending">
              <span class="mono-label">{s.emailPending}</span>
              <span class="visually-hidden">{s.emailPendingHint}</span>
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Band>

<style>
  .team {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team__card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    background: var(--band-raised);
    border: 1px solid var(--band-rule);
    border-block-start: 2px solid var(--band-accent);
    border-radius: var(--radius-card);
  }

  .team__name {
    margin: 0;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .team__role {
    margin: 0;
    flex: 1 1 auto;
    color: var(--band-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .team__email {
    align-self: flex-start;
    /* Padding brings the row to a 24px target without an outsized hit area. */
    padding-block: 0.1875rem;
    font-size: 0.8125rem;
    /* Long addresses must not push the card wider than the grid track. */
    overflow-wrap: anywhere;
  }

  .team__pending {
    margin: 0;
  }

  .team__pending .mono-label {
    display: inline-block;
    padding: 0.1875rem 0.5rem;
    border: 1px dashed var(--band-rule);
    border-radius: var(--radius-card);
    color: var(--band-muted);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }

  @media (min-width: 40rem) {
    .team {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .team {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
