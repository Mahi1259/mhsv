---
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.team;
---

<Band
  locale={locale}
  anchor={s.anchor}
  title={s.title}
  type={type}
 
  lead={s.lead}
>
  <ul class="team" data-stagger data-rows>
    {
      s.members.map((member) => (
        <li class="team__card card">
          <h3 class="team__name">{member.name}</h3>
          <p class="team__role">{member.role}</p>
          <a class="link team__email" href={`mailto:${member.email}`}>{member.email}</a>
        </li>
      ))
    }
  </ul>
</Band>
<style>
  .team {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team__card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    border-block-start: 2px solid var(--band-accent);
  }

  .team__name {
    margin: 0;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .team__email {
    align-self: flex-start;
    margin-block-start: 0.875rem;
    padding-block: 0.1875rem;
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .team__role {
    margin: 0;
    flex: 1 1 auto;
    color: var(--band-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  @media (min-width: 40rem) {
    .team {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .team {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
