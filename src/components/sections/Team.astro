---
/**
 * Organisation & governance — grid type.
 *
 * Shows exactly the six people approved in the 14 August brief, with no
 * photographs. Every address except the founder's is infos@mhsv.ch: individual
 * professional addresses exist but must not be published before further
 * written approval.
 *
 * Cards stay modular so photos, biographies and further members can be added
 * later without touching this component — they are driven entirely by the
 * content JSON.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.team;
---

<Band
  locale={locale}
  anchor={s.anchor}
  title={s.title}
  type={type}
 
  lead={s.lead}
>
  <ul class="team" data-stagger data-rows>
    {
      s.members.map((member) => (
        <li class="team__card card">
          <h3 class="team__name">{member.name}</h3>
          <p class="team__role">{member.role}</p>
          {member.email ? (
            <a class="link team__email" href={`mailto:${member.email}`}>
              {member.email}
            </a>
          ) : (
            <p class="team__pending">
              <span class="mono-label">{s.emailPending}</span>
              <span class="visually-hidden">{s.emailPendingHint}</span>
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Band>

<style>
  .team {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team__card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    border-block-start: 2px solid var(--band-accent);
  }

  .team__name {
    margin: 0;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .team__role {
    margin: 0;
    flex: 1 1 auto;
    color: var(--band-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .team__email {
    align-self: flex-start;
    padding-block: 0.1875rem;
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .team__pending {
    margin: 0;
  }

  .team__pending .mono-label {
    display: inline-block;
    padding: 0.1875rem 0.5rem;
    border: 1px dashed var(--band-rule);
    border-radius: var(--radius);
    color: var(--band-muted);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }

  @media (min-width: 40rem) {
    .team {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .team {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
