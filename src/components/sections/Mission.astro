---
/**
 * Our mission - grid type.
 *
 * Unnumbered on purpose. These six areas are a set, not a sequence: numbering
 * them added a second layer of "slide deck" on top of the section numbers,
 * and implied a precedence the content pack never states.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.mission;
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type}>
  <ul class="mission" data-stagger data-rows>
    {
      s.items.map((item) => (
        <li class="mission__item card">
          <h3 class="mission__title">{item.title}</h3>
          <p class="mission__body">{item.body}</p>
        </li>
      ))
    }
  </ul>
</Band>

<style>
  .mission {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mission__item {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    border-block-start: 2px solid var(--band-accent);
  }

  .mission__title {
    margin: 0;
    font-size: var(--text-h3);
  }

  .mission__body {
    margin: 0;
    color: var(--band-muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 40rem) {
    .mission {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .mission {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
