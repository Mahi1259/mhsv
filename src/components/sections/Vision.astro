---
/**
 * Vision 2035 — statement type.
 *
 * Numbering is kept here: the three phases are a genuine sequence
 * (structure -> consolidate -> deploy), so the order carries meaning. An
 * ordered list keeps that true with CSS off.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.vision;
---

<Band
  locale={locale}
  anchor={s.anchor}
  title={s.title} titleLines={s.titleLines}
  type={type}
 
  lead={s.lead}
>
  <ol class="arc">
    {
      s.steps.map((step, i) => (
        <li class="arc__step" style={`--i:${i}`}>
          <span class="arc__phase mono-label" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="arc__label">{step}</span>
        </li>
      ))
    }
  </ol>
  <p class="prose-body vision__note">{s.note}</p>
</Band>

<style>
  .arc {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .arc__step {
    display: grid;
    gap: 0.625rem;
    padding-block-start: 1.125rem;
    border-block-start: 2px solid var(--band-accent);
  }

  .arc__phase {
    color: var(--band-accent);
    font-size: 0.6875rem;
  }

  .arc__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .vision__note {
    margin-block-start: 2.5rem;
  }

  @media (min-width: 48rem) {
    .arc {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>
