---
/**
 * Identity, logos & collection - quiet type.
 *
 * Only MHSV_Primary_Logo_HD.png is published. The REFERENCE_ONLY variants are
 * neither imported nor referenced, and no collection imagery is shown: the
 * mock-ups are REVIEW_REQUIRED and the collection sheets carry third-party
 * logos. Only the wording the client requires verbatim appears.
 */
import { Image } from 'astro:assets';
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';
import logo from '@/assets/logo/mhsv-logo.png';

interface Props { locale: Locale; type: SectionType }
const { locale, type } = Astro.props;
const s = getContent(locale).sections.identity;
const placeholders = [s.placeholderOfficial, s.placeholderInstitutional, s.placeholderEquipment];
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type} lead={s.lead} status={s.status}>
  <div class="identity">
    <figure class="identity__primary" data-reveal-x>
      <div class="identity__plate">
        <Image src={logo} alt={s.logoTitle} widths={[200, 340]} sizes="(min-width: 52rem) 11rem, 45vw" loading="lazy" decoding="async" />
      </div>
      <figcaption>
        <span class="mono-label identity__caption">{s.logoTitle}</span>
        <span class="identity__note">{s.logoNote}</span>
      </figcaption>
    </figure>

    <div>
      <h3 class="mono-label identity__reservedTitle">{s.placeholdersTitle}</h3>
      <ul class="identity__slots">
        {placeholders.map((label) => (
          <li class="identity__slot">
            <span class="identity__slotLabel">{label}</span>
            <span class="identity__slotNote">{s.placeholderNote}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="identity__collection">{s.collectionNotice}</p>
</Band>

<style>
  .identity { display: grid; gap: 2rem; align-items: start; }
  .identity__primary { margin: 0; }
  /* The same raised surface the cards use, not a white plate. It is the
     identical asset the hero shows directly on navy - its background is
     transparent, so the plate was never doing anything but putting a white
     rectangle on the page. */
  .identity__plate {
    display: grid; place-items: center; padding: 1.5rem;
    background: var(--band-raised); border: 1px solid var(--band-rule); border-radius: var(--radius);
  }
  .identity__plate :global(img) { width: 100%; max-width: 11rem; height: auto; }
  .identity__primary figcaption { display: grid; gap: 0.375rem; margin-block-start: 0.875rem; }
  .identity__caption { color: var(--band-accent); }
  .identity__note { color: var(--band-muted); font-size: 0.8125rem; line-height: 1.5; }
  .identity__reservedTitle { color: var(--band-muted); margin: 0 0 1rem; }
  .identity__slots { display: grid; gap: 0.75rem; list-style: none; margin: 0; padding: 0; }
  .identity__slot {
    display: grid; gap: 0.25rem; align-content: center; min-height: 5rem; padding: 1rem;
    border: 1px dashed var(--band-rule); border-radius: var(--radius);
    background: var(--band-raised); text-align: center;
  }
  .identity__slotLabel {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--band-fg);
  }
  .identity__slotNote { font-size: 0.75rem; color: var(--band-muted); }
  .identity__collection {
    margin-block-start: 2rem; padding: 1rem 1.25rem;
    border: 1px solid var(--band-rule); border-inline-start: 3px solid var(--band-accent);
    border-radius: var(--radius); background: var(--band-raised);
    font-size: 0.9375rem; line-height: 1.55;
  }
  @media (min-width: 52rem) {
    .identity { grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: 2.5rem; }
    .identity__slots { grid-template-columns: repeat(3, 1fr); }
  }
</style>
