---
/** Sport programmes in action - statement type. Carries a status: this is a
    target for the first deployment phase, not an operating programme. */
import Band from '@/components/Band.astro';
import SectionImage from '@/components/SectionImage.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props { locale: Locale; type: SectionType }
const { locale, type } = Astro.props;
const s = getContent(locale).sections.programmes;
---

<Band locale={locale} anchor={s.anchor} title={s.title} titleLines={s.titleLines} type={type} lead={s.lead} status={s.status}>
  <div class="prose-body">
    {s.paragraphs.map((text) => <p>{text}</p>)}
  </div>

  <SectionImage locale={locale} image="programmes" align="start" />
</Band>
