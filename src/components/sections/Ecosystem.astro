---
/** Coordinated ecosystem — grid type. */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import { capitalizeFirst } from '@/lib/text';
import type { Surface, SectionType } from '@/config/site';

interface Props { locale: Locale; type: SectionType; surface: Surface }
const { locale, type, surface } = Astro.props;
const s = getContent(locale).sections.ecosystem;
const disciplines = s.disciplines.map((item) => capitalizeFirst(item, locale));
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type} surface={surface} lead={s.lead}>
  <h3 class="mono-label ecosystem__title">{s.disciplinesTitle}</h3>
  <ul class="chips" data-stagger data-rows>
    {disciplines.map((item) => <li class="chip">{item}</li>)}
  </ul>
  <p class="prose-body ecosystem__note">{s.note}</p>
</Band>

<style>
  .ecosystem__title { color: var(--band-muted); margin: 0 0 1rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .chip {
    padding: 0.5rem 0.9375rem;
    background: var(--band-raised);
    border: 1px solid var(--band-rule);
    border-radius: 999px;
    font-size: 0.875rem;
    line-height: 1.3;
    transition: border-color 180ms var(--ease), transform 180ms var(--ease);
  }
  .chip:hover { border-color: var(--band-accent); transform: translateY(-2px); }
  .ecosystem__note { margin-block-start: 2rem; }
</style>
