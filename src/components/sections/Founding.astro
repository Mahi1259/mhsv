---
/**
 * Founding programmes & fees — feature type.
 *
 * MERGE: the content pack keeps these as two sections (§10 Founding
 * programmes, §13 Fees & access). Rendered separately, the CHF 15,000 launch
 * rate was stated three times on one page — once in each programme table and
 * again in the fees section. They are one section now, and the rate is stated
 * exactly once.
 *
 * The fee rows are filtered out of the two programme tables by detecting the
 * currency in the value, which works across all four locales without a
 * per-language label list.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { Surface, SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
  surface: Surface;
}

const { locale, type, surface } = Astro.props;
const c = getContent(locale);
const s = c.sections.founding;
const fees = c.sections.fees;

const tables = s.tables.map((table) => ({
  ...table,
  entries: table.entries.filter((entry) => !/CHF/i.test(entry.value)),
}));

/** "CHF 15'000 / year / beneficiary - launch rate" -> amount + qualifier. */
const match = /^(.*?)\s[-–—]\s(.*)$/.exec(fees.priceLine);
const amount = match ? match[1] : fees.priceLine;
const qualifier = match ? match[2] : null;
---

<Band
  locale={locale}
  anchor={s.anchor}
  title={s.title}
  type={type}
  surface={surface}
  lead={s.lead}
>
  <div class="offer">
    <aside class="fee" data-reveal-x>
      <div class="fee__headline">
        <h3 class="fee__plan mono-label">{fees.planName}</h3>
        <p class="fee__amount" data-count>{amount}</p>
      </div>
      <div class="fee__meta">
        {qualifier && <p class="fee__qualifier mono-label">{qualifier}</p>}
        <p class="fee__included">{fees.included}</p>
      </div>
    </aside>

    <div class="offer__programmes" data-stagger>
      {
        tables.map((table) => (
          <article class="programme card">
            <h3 class="programme__title">{table.title}</h3>
            <dl class="programme__list">
              {table.entries.map((entry) => (
                <div class="programme__row">
                  <dt>{entry.label}</dt>
                  <dd>{entry.value}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </div>

  <div class="prose-body offer__notes">
    {fees.paragraphs.map((text) => <p>{text}</p>)}
  </div>
</Band>

<style>
  .offer {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  .offer__programmes {
    display: grid;
    gap: 1.25rem;
    /* Cards size to their own content. Stretching them to a common height left
       the shorter one with a large empty tail — the two programmes genuinely
       have different numbers of rows. */
    align-items: start;
  }

  .programme {
    align-content: start;
  }

  .programme__title {
    margin: 0 0 1.125rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--band-accent);
    line-height: 1.4;
  }

  .programme__list {
    margin: 0;
    display: grid;
  }

  .programme__row {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.6875rem;
    border-block-start: 1px solid var(--band-rule);
  }

  .programme__row:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .programme__row dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--band-muted);
  }

  .programme__row dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  /*
   * The launch rate — stated once on the page, as a wide strip rather than a
   * tall third column. As a column it forced the two programme cards into
   * ~390px each, which was too narrow to set a label beside its value.
   */
  .fee {
    display: grid;
    gap: 0.875rem;
    padding: clamp(1.125rem, 0.9rem + 0.9vw, 1.5rem) clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--band-rule);
    border-inline-start: 3px solid var(--band-accent);
    border-radius: var(--radius);
    background: var(--band-raised);
  }

  .fee__plan {
    margin: 0;
    color: var(--band-muted);
    line-height: 1.5;
    font-size: 0.6875rem;
  }

  .fee__amount {
    margin: 0.375rem 0 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 1.15rem + 1.6vw, 2.125rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--band-accent);
    font-variant-numeric: tabular-nums;
  }

  .fee__qualifier {
    margin: 0;
    color: var(--band-fg);
  }

  .fee__included {
    margin: 0.375rem 0 0;
    color: var(--band-muted);
    font-size: 0.8125rem;
  }

  .offer__notes {
    margin-block-start: 2rem;
    max-width: none;
    font-size: 0.9375rem;
  }

  @media (min-width: 40rem) {
    .offer__programmes {
      grid-template-columns: repeat(2, 1fr);
    }

    /*
     * Label beside value, not above it. Stacked, each row cost 77px and the
     * card ran to 464px with most of its width empty; side by side the same
     * content reads in roughly half the height.
     */
    .programme__row {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 0.875rem;
      align-items: baseline;
    }

    /* Two columns of notes rather than one long measure. */
    .offer__notes {
      columns: 2;
      column-gap: 2.5rem;
    }

    .offer__notes > p {
      break-inside: avoid;
      margin-block-start: 0;
    }

    .offer__notes > p + p {
      margin-block-start: 1em;
    }
  }

  @media (min-width: 52rem) {
    /* Headline left, terms right — one line rather than a stacked block. */
    .fee {
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: center;
    }

    .fee__meta {
      justify-self: end;
      text-align: right;
    }
  }
</style>
