---
/** Projects, inclusion & deployment - quiet type. */
import Band from '@/components/Band.astro';
import SectionImage from '@/components/SectionImage.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props { locale: Locale; type: SectionType }
const { locale, type } = Astro.props;
const s = getContent(locale).sections.inclusion;
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type} status={s.status}>
  <div class="prose-body">
    {s.paragraphs.map((text) => <p>{text}</p>)}

  <SectionImage locale={locale} image="inclusion" align="end" />
</Band>
