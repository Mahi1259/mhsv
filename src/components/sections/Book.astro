---
/**
 * The Premium Founding Book - feature type.
 *
 * Covers only. The full PDFs are INTERNAL_REFERENCE and are never copied into
 * the build - there is deliberately no download link here and no path that
 * could become one.
 *
 * The primary action is the order request, which lives on the permanent
 * /livre page (the address encoded in the printed QR code).
 */
import { Picture } from 'astro:assets';
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import { BOOK_PAGE_PATH, type SectionType } from '@/config/site';
import coverFr from '@/assets/book/founding-book-fr.png';
import coverEn from '@/assets/book/founding-book-en.png';
/*
 * Generated and payload-verified by scripts/generate-web-qr.mjs, which decodes
 * the code before writing it. Same URL as the printed one on the back cover.
 */
import qrCode from '@/assets/qr/mhsv-livre-qr-web.svg?raw';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.book;

const covers = [
  { src: coverFr, alt: s.coverAltFr, edition: 'FR' },
  { src: coverEn, alt: s.coverAltEn, edition: 'EN' },
];
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type}>
  <div class="book">
    <ul class="book__covers" data-reveal-x>
      {
        covers.map((cover) => (
          <li class="book__cover" style={`flex-grow: ${cover.src.width / cover.src.height}`}>
            {/* Flex-grow set to the cover's own aspect ratio, so the two
                widths come out in proportion to their shapes and the two
                HEIGHTS come out equal. The supplied files no longer share a
                ratio once their pale borders are trimmed - 0.697 and 0.752 -
                and equal widths made one book look smaller than the other. */}
            <Picture
              src={cover.src}
              alt={cover.alt}
              formats={['webp']}
              fallbackFormat="png"
              widths={[280, 460, 620]}
              sizes="(min-width: 52rem) 14rem, 40vw"
              loading="lazy"
              decoding="async"
            />
            <span class="book__edition mono-label" aria-hidden="true">{cover.edition}</span>
          </li>
        ))
      }
    </ul>

    <div class="book__text">
      <p class="book__kicker mono-label">{s.lead}</p>
      <p class="prose-body book__body">{s.body}</p>
      <p class="book__notice">{s.notice}</p>
      <div class="book__actions">
        <a class="btn btn--primary book__cta" href={BOOK_PAGE_PATH} data-magnetic>{s.ctaLabel}</a>

        {/* Desktop only, and hidden from assistive technology: a QR code is a
            way to move a page from this screen to a phone, which is pointless
            on the phone itself and unusable by a screen reader. The button
            beside it goes to the same place, so nothing is lost by hiding it -
            whereas announcing "QR code" to someone who cannot scan it is
            noise. Title on the <svg> keeps it labelled if that ever changes. */}
        <figure class="book__qr" aria-hidden="true">
          <div class="book__qrCode" role="img" aria-label={s.qrAlt} set:html={qrCode} />
          <figcaption class="book__qrCaption">{s.qrCaption}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</Band>

<style>
  .book {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .book__covers {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .book__cover {
    position: relative;
    /* grow is set per cover, inline, from its aspect ratio. */
    flex: 0 1 0;
    max-width: 18rem;
    transition: transform 250ms var(--ease);
  }

  .book__cover:hover {
    transform: translateY(-4px);
  }

  .book__cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--band-rule);
    box-shadow: 0 20px 44px rgb(0 0 0 / 0.45);
  }

  .book__edition {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    padding: 0.1875rem 0.4375rem;
    background: var(--navy-deep);
    color: var(--gold);
    font-size: 0.625rem;
  }

  .book__kicker {
    margin: 0 0 1rem;
    color: var(--band-accent);
    line-height: 1.5;
    font-size: 0.6875rem;
  }

  .book__notice {
    margin-block-start: 1.5rem;
    padding: 0.875rem 1rem;
    border: 1px dashed var(--band-rule);
    border-radius: var(--radius);
    color: var(--band-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .book__actions {
    margin-block-start: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .book__cta {
    margin-block-start: 0;
  }

  /*
   * Hidden below the desktop breakpoint. `display: none` rather than a visual
   * hide, so the markup costs a phone nothing.
   */
  .book__qr {
    display: none;
    margin: 0;
    align-items: center;
    gap: 0.875rem;
  }

  /* White, always. The code needs its light quiet zone to scan - tinting it to
     match the band would make it decorative and unreadable. */
  .book__qrCode {
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    padding: 0.375rem;
    border-radius: calc(var(--radius) / 2);
    background: #fff;
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.35);
  }

  .book__qrCode :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .book__qrCaption {
    max-width: 22ch;
    color: var(--band-muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  @media (min-width: 52rem) {
    .book__qr {
      display: flex;
    }
  }

  @media (min-width: 52rem) {
    .book {
      /* The covers ARE the section here - they were sized like a thumbnail
         beside the copy. */
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
</style>
