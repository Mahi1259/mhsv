---
/**
 * The Premium Founding Book - feature type.
 *
 * Covers only. The full book PDFs are never copied into the build - there is
 * deliberately no download link here and no path that could become one, and
 * build:check fails if a PDF ever appears in the output.
 *
 * The primary action is the order request, which lives on the permanent
 * /livre page (the address encoded in the printed QR code).
 */
import { Picture } from 'astro:assets';
import Band from '@/components/Band.astro';
import QrPlaceholder from '@/components/QrPlaceholder.astro';
import { getContent, type Locale } from '@/lib/i18n';
import { BOOK_PAGE_PATH, type SectionType } from '@/config/site';
import coverFr from '@/assets/book/founding-book-fr.png';
import coverEn from '@/assets/book/founding-book-en.png';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const s = getContent(locale).sections.book;

/*
 * /livre is bilingual and picks its language from ?lang - it is one permanent
 * URL because the printed QR encodes it and cannot be changed.
 *
 * Linking to the bare path from the English site sent readers to the French
 * version: English copy on the page they came from, then a French order form
 * headed "Envoyer ma demande". The path itself is untouched, so the QR still
 * lands exactly where it always did.
 *
 * DE and IT get the English side, matching how they are handled everywhere
 * else - the book page has no German or Italian version.
 */
const bookHref = locale === 'fr' ? BOOK_PAGE_PATH : `${BOOK_PAGE_PATH}?lang=en`;

const covers = [
  { src: coverFr, alt: s.coverAltFr, edition: 'FR' },
  { src: coverEn, alt: s.coverAltEn, edition: 'EN' },
];
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type}>
  <div class="book">
    <ul class="book__covers" data-reveal-x>
      {
        covers.map((cover) => (
          <li class="book__cover" style={`flex-grow: ${cover.src.width / cover.src.height}`}>
            {/* Flex-grow set to the cover's own aspect ratio, so the two
                widths come out in proportion to their shapes and the two
                HEIGHTS come out equal. The supplied files no longer share a
                ratio once their pale borders are trimmed - 0.697 and 0.752 -
                and equal widths made one book look smaller than the other. */}
            <Picture
              src={cover.src}
              alt={cover.alt}
              formats={['webp']}
              fallbackFormat="png"
              widths={[280, 460, 620]}
              sizes="(min-width: 52rem) 14rem, 40vw"
              loading="lazy"
              decoding="async"
            />
            <span class="book__edition mono-label" aria-hidden="true">{cover.edition}</span>
          </li>
        ))
      }
    </ul>

    <div class="book__text">
      <p class="book__kicker mono-label">{s.lead}</p>
      <p class="prose-body book__body">{s.body}</p>
      <p class="book__notice">{s.notice}</p>
      {/*
        The order request is the only ACTION here. The QR beside it is a
        reserved space, not a control: the 27 August round removed a QR that
        pointed at the wrong target, and the 28 August one asks for the space to
        be held until the real code can be made. Nothing is generated - see
        QrPlaceholder.
      */}
      <a class="btn btn--primary book__cta" href={bookHref} data-magnetic>{s.ctaLabel}</a>

      <QrPlaceholder locale={locale} class="book__qr" />
    </div>
  </div>
</Band>

<style>
  .book {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .book__covers {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .book__cover {
    position: relative;
    /* grow is set per cover, inline, from its aspect ratio. */
    flex: 0 1 0;
    max-width: 18rem;
    transition: transform 250ms var(--ease);
  }

  .book__cover:hover {
    transform: translateY(-4px);
  }

  .book__cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--band-rule);
    box-shadow: 0 20px 44px rgb(0 0 0 / 0.45);
  }

  .book__edition {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    padding: 0.1875rem 0.4375rem;
    background: var(--navy-deep);
    color: var(--gold);
    font-size: 0.625rem;
  }

  .book__kicker {
    margin: 0 0 1rem;
    color: var(--band-accent);
    line-height: 1.5;
    font-size: 0.6875rem;
  }

  .book__notice {
    margin-block-start: 1.5rem;
    padding: 0.875rem 1rem;
    border: 1px dashed var(--band-rule);
    border-radius: var(--radius);
    color: var(--band-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .book__cta {
    margin-block-start: 1.75rem;
  }

  .book__qr {
    margin-block-start: 1.75rem;
  }

  @media (min-width: 52rem) {
    .book {
      /* The covers ARE the section here - they were sized like a thumbnail
         beside the copy. */
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
</style>
