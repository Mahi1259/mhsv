---
/** §07 — Services: nine areas. */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import { capitalizeFirst } from '@/lib/text';
import type { BandTone } from '@/config/site';

interface Props {
  locale: Locale;
  tone: BandTone;
}

const { locale, tone } = Astro.props;
const s = getContent(locale).sections.services;

// The pack writes this as one running sentence, so only the first item is
// capitalised in the source.
const items = s.items.map((item) => capitalizeFirst(item, locale));
---

<Band locale={locale} anchor={s.anchor} num={s.num} title={s.title} tone={tone} lead={s.lead}>
  <ol class="services">
    {
      items.map((item, i) => (
        <li class="service">
          <span class="service__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="service__name">{item}</h3>
        </li>
      ))
    }
  </ol>
</Band>

<style>
  .services {
    display: grid;
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--band-rule);
    border: 1px solid var(--band-rule);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .service {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    padding: 1.125rem clamp(1rem, 0.85rem + 0.6vw, 1.5rem);
    background: var(--band-bg);
  }

  .service__num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--band-accent);
    flex: 0 0 auto;
  }

  .service__name {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .services {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
