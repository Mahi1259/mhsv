---
/**
 * Services — grid type.
 *
 * Unnumbered: nine areas of intervention, mobilised as needed. Not a sequence.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import { capitalizeFirst } from '@/lib/text';
import type { BandTone, SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
  tone: BandTone;
  fade?: boolean;
}

const { locale, type, tone, fade } = Astro.props;
const s = getContent(locale).sections.services;
// The pack writes this as one running sentence, so only the first item is
// capitalised in the source.
const items = s.items.map((item) => capitalizeFirst(item, locale));
---

<Band
  locale={locale}
  anchor={s.anchor}
  title={s.title}
  type={type}
  tone={tone}
  fade={fade}
  lead={s.lead}
>
  <ul class="services" data-stagger>
    {
      items.map((item) => (
        <li class="service">
          <span class="service__mark" aria-hidden="true" />
          <h3 class="service__name">{item}</h3>
        </li>
      ))
    }
  </ul>
</Band>

<style>
  .services {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    padding-block: 1rem;
    border-block-end: 1px solid var(--band-rule);
  }

  .service__mark {
    width: 0.5rem;
    height: 1px;
    flex: 0 0 auto;
    background: var(--band-accent);
    transform: translateY(-0.35em);
  }

  .service__name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 2.5rem;
    }
  }

  @media (min-width: 64rem) {
    .services {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 3rem;
    }
  }
</style>
