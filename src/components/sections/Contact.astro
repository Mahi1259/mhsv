---
/**
 * Contact — feature type.
 *
 * The ONLY place the contact details appear. They were previously repeated in
 * the footer's contact column as well, so the address, phone and email showed
 * up three times on one page.
 *
 * Addresses follow the 14 August brief: infos@mhsv.ch is the institutional
 * mailbox, m.happi@mhsv.ch the founder.
 */
import Band from '@/components/Band.astro';
import ContactForm from '@/components/ContactForm.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { Surface, SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
  surface: Surface;
}

const { locale, type, surface } = Astro.props;
const c = getContent(locale);
const s = c.sections.contact;

const rows = [
  { label: s.websiteLabel, value: s.website, href: `https://${s.website.replace(/^https?:\/\//, '')}` },
  { label: s.emailLabel, value: s.email, href: `mailto:${s.email}` },
  { label: s.founderLabel, value: s.founderEmail, href: `mailto:${s.founderEmail}` },
  { label: null, value: s.phone, href: `tel:${s.phone.replace(/\s+/g, '')}` },
];
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type} surface={surface}>
  <p class="contact__tagline">{s.tagline}</p>

  <div class="contact">
    <div class="contact__details">
      <h3 class="mono-label contact__title">{s.detailsTitle}</h3>
      <address class="contact__address">
        <span class="contact__org">{s.institutional}</span>
        <span class="contact__place">{s.place}</span>
        {
          rows.map((row) => (
            <span class="contact__row">
              {row.label && <span class="contact__label">{row.label}</span>}
              <a class="link" href={row.href}>
                {row.value}
              </a>
            </span>
          ))
        }
      </address>
    </div>

    <div class="contact__form">
      <h3 class="mono-label contact__title">{s.formTitle}</h3>
      <ContactForm locale={locale} />
    </div>
  </div>
</Band>

<style>
  .contact__tagline {
    margin: 0 0 clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    color: var(--band-accent);
    max-width: 22ch;
  }

  .contact {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .contact__title {
    color: var(--band-muted);
    margin: 0 0 1.25rem;
  }

  .contact__address {
    display: grid;
    gap: 0.75rem;
    font-style: normal;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .contact__org {
    color: var(--band-fg);
    font-weight: 600;
  }

  .contact__place {
    color: var(--band-muted);
  }

  .contact__row {
    display: grid;
    gap: 0.125rem;
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--band-muted);
  }

  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }
</style>
