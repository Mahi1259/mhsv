---
/**
 * §21 — Contact & legal.
 *
 * The legal footer block from the pack is rendered by Footer.astro behind
 * SHOW_LEGAL_STATUS; this section carries the public contact details and the
 * form.
 */
import Band from '@/components/Band.astro';
import ContactForm from '@/components/ContactForm.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { BandTone } from '@/config/site';

interface Props {
  locale: Locale;
  tone: BandTone;
}

const { locale, tone } = Astro.props;
const c = getContent(locale);
const s = c.sections.contact;
---

<Band locale={locale} anchor={s.anchor} num={s.num} title={s.title} tone={tone} lead={s.lead}>
  <p class="contact__tagline">{s.tagline}</p>

  <div class="contact">
    <div class="contact__details">
      <h3 class="mono-label contact__title">{s.detailsTitle}</h3>
      <address class="contact__address">
        <span class="contact__org">{s.institutional}</span>
        <span>{s.place}</span>
        <a class="link" href={`tel:${s.phone.replace(/\s+/g, '')}`}>{s.phone}</a>
        <a class="link" href={`mailto:${s.email}`}>{s.email}</a>
        <a class="link" href={`https://${s.website.replace(/^https?:\/\//, '')}`}>{s.website}</a>
      </address>
    </div>

    <div class="contact__form">
      <h3 class="mono-label contact__title">{s.formTitle}</h3>
      <ContactForm locale={locale} />
    </div>
  </div>
</Band>

<style>
  .contact__tagline {
    margin: 0 0 clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    color: var(--band-accent);
    max-width: 22ch;
  }

  .contact {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .contact__title {
    color: var(--band-muted);
    margin: 0 0 1.25rem;
  }

  .contact__address {
    display: grid;
    gap: 0.5rem;
    font-style: normal;
    font-size: 0.9375rem;
    color: var(--band-muted);
    overflow-wrap: anywhere;
  }

  .contact__org {
    color: var(--band-fg);
  }

  @media (min-width: 52rem) {
    .contact {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 3rem;
    }
  }
</style>
