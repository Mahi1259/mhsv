---
import Band from '@/components/Band.astro';
import { Image } from 'astro:assets';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
}

const { locale, type } = Astro.props;
const c = getContent(locale);
const s = c.sections.supporters;

type Category = 'patron' | 'partner' | 'ambassador';

type Profile = {
  name: string;
  category: Category;
  role?: string | null;
  intro?: string | null;
  message?: string | null;
  photo?: string | null;
  website?: string | null;
  video?: string | null;
};

const profiles = (s.profiles ?? []) as Profile[];

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/supporters/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const imageFor = (file?: string | null) =>
  file ? Object.entries(images).find(([path]) => path.endsWith(`/${file}`))?.[1].default : undefined;

const groups = s.categories
  .map((category) => ({ ...category, entries: profiles.filter((p) => p.category === category.key) }))
  .filter((group) => group.entries.length > 0);
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type} status={s.status}>
  <p class="prose-body supporters__intro">{s.intro}</p>
  {
    groups.map((group) => (
      <section class="supporters__group">
        <h3 class="supporters__heading">{group.heading}</h3>
        <ul class="supporters__list" data-stagger data-rows>
          {group.entries.map((profile) => {
            const image = imageFor(profile.photo);
            const isOrganisation = profile.category !== 'ambassador';
            return (
              <li class="supporters__card card">
                {image && (
                  <Image
                    class:list={['supporters__image', isOrganisation && 'supporters__image--logo']}
                    src={image}
                    alt={profile.name}
                    widths={[160, 320]}
                    sizes="160px"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <h4 class="supporters__name">{profile.name}</h4>
                {profile.role && <p class="supporters__role mono-label">{profile.role}</p>}
                {profile.intro && <p class="supporters__text">{profile.intro}</p>}
                {profile.message && (
                  <blockquote class="supporters__message">
                    <p>{profile.message}</p>
                  </blockquote>
                )}
                {profile.website && (
                  <a class="link" href={profile.website} target="_blank" rel="noopener noreferrer">
                    {profile.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                  </a>
                )}
                {profile.video && (
                  <a
                    class="link supporters__video"
                    href={profile.video}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {c.ui.watchVideo}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }

  <a class="btn btn--primary supporters__cta" href="#contact" data-magnetic>{s.ctaLabel}</a>
</Band>
<style>
  .supporters__intro {
    max-width: 58ch;
  }

  .supporters__group {
    margin-block-start: 2.5rem;
  }

  .supporters__heading {
    margin: 0 0 1rem;
    font-size: var(--text-h3);
    color: var(--band-accent);
  }

  .supporters__list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 48rem) {
    .supporters__list {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }
  }

  .supporters__image {
    display: block;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    margin-block-end: 1rem;
  }

  .supporters__image--logo {
    width: auto;
    max-width: 9rem;
    height: 3rem;
    border-radius: 0;
    object-fit: contain;
  }

  .supporters__name {
    margin: 0;
    font-size: 1.0625rem;
  }

  .supporters__role {
    margin: 0.25rem 0 0.875rem;
    color: var(--band-accent);
  }

  .supporters__text {
    margin: 0 0 1rem;
    color: var(--band-muted);
  }

  .supporters__message {
    margin: 0 0 1rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--band-accent);
  }

  .supporters__message p {
    margin: 0;
    font-style: italic;
  }

  .supporters__video {
    display: inline-block;
  }

  .supporters__cta {
    margin-block-start: 2.5rem;
  }
</style>
