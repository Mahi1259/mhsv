---
/**
 * §13 — Fees & access.
 *
 * States the launch rate plainly. No claim is made about what a fee buys
 * beyond what the pack says: the exact services live in the programme
 * agreement.
 */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { BandTone } from '@/config/site';

interface Props {
  locale: Locale;
  tone: BandTone;
}

const { locale, tone } = Astro.props;
const s = getContent(locale).sections.fees;

/**
 * "CHF 15'000 / year / beneficiary - launch rate" -> amount + qualifier.
 * Falls back to the whole string if the pack ever drops the trailing dash.
 */
const match = /^(.*?)\s[-–—]\s(.*)$/.exec(s.priceLine);
const amount = match ? match[1] : s.priceLine;
const qualifier = match ? match[2] : null;
---

<Band locale={locale} anchor={s.anchor} num={s.num} title={s.title} tone={tone} lead={s.lead}>
  <div class="fees">
    <div class="fees__price card">
      <h3 class="fees__plan">{s.planName}</h3>
      <p class="fees__amount">{amount}</p>
      {qualifier && <p class="fees__qualifier mono-label">{qualifier}</p>}
      <p class="fees__included mono-label">{s.included}</p>
    </div>
    <div class="prose-body fees__notes">
      {s.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </div>
</Band>

<style>
  .fees {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .fees__price {
    border-block-start: 2px solid var(--band-accent);
  }

  .fees__plan {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--band-muted);
    line-height: 1.5;
  }

  .fees__amount {
    margin: 0.875rem 0 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.25rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--band-accent);
  }

  .fees__qualifier {
    margin: 0.625rem 0 0;
    color: var(--band-fg);
  }

  .fees__included {
    margin: 1.25rem 0 0;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--band-rule);
    color: var(--band-muted);
    letter-spacing: 0.06em;
    text-transform: none;
    font-size: 0.8125rem;
  }

  @media (min-width: 52rem) {
    .fees {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: 3rem;
    }
  }
</style>
