---
/** The founder — statement type. No photo in this phase. */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { BandTone, SectionType } from '@/config/site';

interface Props { locale: Locale; type: SectionType; tone: BandTone }
const { locale, type, tone } = Astro.props;
const s = getContent(locale).sections.founder;
---

<Band locale={locale} anchor={s.anchor} title={s.title} type={type} tone={tone}>
  <blockquote class="founder__quote">
    <p>{s.quote}</p>
  </blockquote>
  <div class="founder__body">
    <p class="founder__name">{s.name}<span class="founder__role">{s.role}</span></p>
    <p class="prose-body">{s.bio}</p>
  </div>
</Band>

<style>
  .founder__quote {
    margin: 0 0 2.5rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 2px solid var(--band-accent);
  }
  .founder__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.875rem);
    letter-spacing: -0.025em;
    line-height: 1.28;
    text-wrap: balance;
    max-width: 26ch;
  }
  .founder__name {
    display: grid;
    gap: 0.25rem;
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
  }
  .founder__role {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--band-accent);
  }
</style>
