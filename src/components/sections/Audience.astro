---
/** Who we support — quiet type: narrow, understated, deliberately recessive. */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { BandTone, SectionType } from '@/config/site';

interface Props {
  locale: Locale;
  type: SectionType;
  tone: BandTone;
  fade?: boolean;
}

const { locale, type, tone, fade } = Astro.props;
const s = getContent(locale).sections.audience;
---

<Band
  locale={locale}
  anchor={s.anchor}
  title={s.title}
  type={type}
  tone={tone}
  fade={fade}
  lead={s.lead}
>
  <ul class="audience">
    {s.items.map((item) => <li class="audience__item">{item}</li>)}
  </ul>
</Band>

<style>
  .audience {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .audience__item {
    padding: 0.4375rem 0.8125rem;
    border: 1px solid var(--band-rule);
    border-radius: 999px;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--band-muted);
  }
</style>
