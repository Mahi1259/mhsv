---
/** §05 — Who we support. */
import Band from '@/components/Band.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { BandTone } from '@/config/site';

interface Props {
  locale: Locale;
  tone: BandTone;
}

const { locale, tone } = Astro.props;
const s = getContent(locale).sections.audience;
---

<Band locale={locale} anchor={s.anchor} num={s.num} title={s.title} tone={tone} lead={s.lead}>
  <ul class="audience">
    {s.items.map((item) => <li class="audience__item">{item}</li>)}
  </ul>
</Band>

<style>
  .audience {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .audience__item {
    position: relative;
    padding: 0.875rem 1rem 0.875rem 2.25rem;
    background: var(--band-raised);
    border: 1px solid var(--band-rule);
    border-radius: var(--radius-card);
    font-size: 0.9375rem;
  }

  .audience__item::before {
    content: '';
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: 1.375rem;
    width: 0.5rem;
    height: 1px;
    background: var(--band-accent);
  }

  @media (min-width: 40rem) {
    .audience {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .audience {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
