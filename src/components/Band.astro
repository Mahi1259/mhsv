---
import StatusBadge from '@/components/StatusBadge.astro';
import { getContent, type Locale } from '@/lib/i18n';
import type { SectionType, StatusKey } from '@/config/site';

interface Props {
  locale: Locale;
  anchor: string;
  title: string;
  titleLines?: string[];
  type: SectionType;
  lead?: string;
  status?: { key: string; detail: string } | null;
  bare?: boolean;
  class?: string;
}

const {
  locale,
  anchor,
  title,
  titleLines,
  type,
  lead,
  status = null,
  bare = false,
  class: className,
} = Astro.props;

const headingId = `${anchor}-title`;
const titleClass = type === 'statement' ? 'statement-title' : 'section-title';

const c = getContent(locale);
const rails = c.railLabels as Record<string, string>;
const navLabel = c.nav.items.find((item) => item.id === anchor)?.label;
const label = rails[anchor] ?? navLabel ?? title;
---

<section
  id={anchor}
  class:list={[
    'band',
    `band--${type}`,
    className,
  ]}
  aria-labelledby={headingId}
>
  <div class="shell band__shell">
    <p class="band__label mono-label" aria-hidden="true">{label}</p>
    <div class="band__main">
      {
        !bare && (
          <header class="band__head" data-reveal>
            {
              titleLines?.length ? (
                <h2 id={headingId} class:list={[titleClass, 'reveal-lines']} data-reveal-lines>
                  {titleLines.map((line) => (
                    <span class="line">
                      <span>{line}</span>
                    </span>
                  ))}
                </h2>
              ) : (
                <h2 id={headingId} class={titleClass}>
                  {title}
                </h2>
              )
            }
            {status && (
              <StatusBadge
                locale={locale}
                status={status.key as StatusKey}
                class="band__status"
              />
            )}
            {lead && <p class="lead band__lead">{lead}</p>}
          </header>
        )
      }
      <div class="band__body" data-reveal>
        <slot />
      </div>
    </div>
  </div>
</section>
<style>
  .band__shell {
    display: block;
  }

  .band__label {
    display: none;
  }

  .band__head {
    max-width: 62rem;
  }

  .band__status {
    margin-block-start: 1.25rem;
  }

  .band__lead {
    margin-block-start: 1.5rem;
  }

  .band__body {
    margin-block-start: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
  }

  .band--statement .band__head {
    max-width: 46rem;
  }

  .band--statement .band__body {
    margin-block-start: clamp(2rem, 1.4rem + 2.6vw, 3.75rem);
  }

  .band--quiet .band__main {
    max-width: 46rem;
  }

  .band--quiet .section-title {
    font-size: var(--text-h3);
    font-weight: 700;
  }

  .band--quiet .band__body {
    margin-block-start: 1.5rem;
  }

  @media (min-width: 64rem) {
    .band__shell {
      display: grid;
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }

    .band__label {
      display: block;
      position: sticky;
      top: 7rem;
      margin: 0;
      color: var(--band-muted);
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .band__main {
      min-width: 0;
    }
  }
</style>
