---
interface Props {
  fr: string;
  en: string;
}

const { fr, en } = Astro.props;
const same = fr === en;
---

{
  same ? (
    <span>{fr}</span>
  ) : (
    <>
      <span class="l10n" lang="fr-CH">
        {fr}
      </span>
      <span class="l10n" lang="en">
        {en}
      </span>
    </>
  )
}
