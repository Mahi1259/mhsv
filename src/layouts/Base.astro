---
/**
 * Document shell: head metadata, skip link, header, footer.
 *
 * `path` is the route *within* a locale ("" for the home page, "privacy/" for
 * the privacy page). Everything locale-aware — canonical, hreflang, the
 * language switcher — is derived from it, so a new page only has to pass its
 * own path once.
 */
import { getContent, localeAlternates, localePath, type Locale } from '@/lib/i18n';
import { SITE_URL, DEFAULT_LOCALE, IS_PRODUCTION } from '@/config/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import preloadFonts from '@/config/preload-fonts.json';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  path?: string;
  title?: string;
  description?: string;
  /** Set on pages that exist for a flow, not for search (form results). */
  noindex?: boolean;
}

const { locale, path = '', title, description, noindex = false } = Astro.props;
const c = getContent(locale);

const pageTitle = title ? `${title} — ${c.brand.name}` : c.seo.title;
const pageDescription = description ?? c.seo.description;

const alternates = localeAlternates(path);
const canonical = new URL(localePath(path, locale), SITE_URL).href;
const ogImage = new URL('/og-image.png', SITE_URL).href;
---

<!doctype html>
<html lang={c.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {
      /* Preview and local builds are never indexable, whatever the page says. */
      (noindex || !IS_PRODUCTION) && <meta name="robots" content="noindex, follow" />
    }
    <link rel="canonical" href={canonical} />

    {/* Every language has a real URL, so search engines can index all four. */}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.path, SITE_URL).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(path, DEFAULT_LOCALE), SITE_URL).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={c.brand.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.seo.ogImageAlt} />
    <meta property="og:locale" content={c.meta.ogLocale} />
    {
      alternates
        .filter((alt) => alt.locale !== locale)
        .map((alt) => <meta property="og:locale:alternate" content={alt.ogLocale} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={c.seo.ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0C1D3A" />

    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
  </head>

  <body>
    <script is:inline>
      /*
       * Two things have to be settled before the first paint, or switching
       * language from the middle of the page looks broken. Inline and in the
       * document head region on purpose: a bundled module would run too late
       * to matter.
       *
       * 1. THE FRAGMENT LANDING MUST BE INSTANT. `scroll-behavior: smooth` is
       *    set on :root for in-page navigation, but the browser also applies
       *    it to the fragment scroll it performs on load. Arriving at
       *    /de/#team therefore opened the German page at the top and glided
       *    down to the section — the page appearing to move on translate.
       *    Forced to `auto` here and handed back afterwards, so clicking a
       *    section in the nav is still smooth.
       *
       * 2. THE MASTHEAD MUST NOT ANIMATE INTO ITS SHRUNK STATE ON ARRIVAL.
       *    Landing part-way down the page, it would otherwise play its 480ms
       *    contraction while the reader watches.
       */
      (function () {
        var root = document.documentElement;
        root.classList.add('is-booting');
        root.style.scrollBehavior = 'auto';
        addEventListener('load', function () {
          requestAnimationFrame(function () {
            root.style.scrollBehavior = '';
            root.classList.remove('is-booting');
          });
        });
      })();
    </script>

    <a class="skip-link" href="#main">{c.ui.skipToContent}</a>

    {/* Decorative only. Both are removed entirely under reduced motion, and
        the floodlight never registers on a touch device. */}
    <div class="floodlight" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress__bar"></div></div>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      import '@/scripts/motion.ts';
      import '@/scripts/effects.ts';
      import '@/scripts/forms.ts';
      import '@/scripts/lang-anchor.ts';
    </script>
  </body>
</html>
