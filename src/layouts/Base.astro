---
import { getContent, localeAlternates, localePath, pathForLocale, type Locale } from '@/lib/i18n';
import { SITE_URL, DEFAULT_LOCALE, IS_PRODUCTION } from '@/config/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import preloadFonts from '@/config/preload-fonts.json';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, path = '', title, description, noindex = false } = Astro.props;
const c = getContent(locale);

const pageTitle = title ? `${title} | ${c.brand.name}` : c.seo.title;
const pageDescription = description ?? c.seo.description;

const alternates = localeAlternates(path);
const canonical = new URL(localePath(path, locale), SITE_URL).href;
const ogImage = new URL('/og-image.png', SITE_URL).href;
---

<!doctype html>
<html lang={c.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {
      !IS_PRODUCTION ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        noindex && <meta name="robots" content="noindex, follow" />
      )
    }
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.path, SITE_URL).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pathForLocale(path, DEFAULT_LOCALE), SITE_URL).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={c.brand.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.seo.ogImageAlt} />
    <meta property="og:locale" content={c.meta.ogLocale} />
    {
      alternates
        .filter((alt) => alt.locale !== locale)
        .map((alt) => <meta property="og:locale:alternate" content={alt.ogLocale} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={c.seo.ogImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0C1D3A" />
    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
  </head>
  <body>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('is-booting');
        root.style.scrollBehavior = 'auto';
        addEventListener('load', function () {
          requestAnimationFrame(function () {
            root.style.scrollBehavior = '';
            root.classList.remove('is-booting');
          });
        });
      })();
    </script>
    <a class="skip-link" href="#main">{c.ui.skipToContent}</a>
    <Header locale={locale} path={path} />
    <script is:inline>
      (function () {
        var hash = location.hash;
        if (hash.length < 2 || hash === '#main' || hash === '#top') return;
        if (!matchMedia('(min-width: 62rem)').matches) return;
        var header = document.querySelector('.site-header');
        if (header) header.classList.add('is-shrunk');
      })();
    </script>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieBanner locale={locale} />
    <script>
      import '@/scripts/motion.ts';
      import '@/scripts/effects.ts';
      import '@/scripts/forms.ts';
      import '@/scripts/lang-anchor.ts';
    </script>
  </body>
</html>
