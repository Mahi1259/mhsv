# Copy to .env for local development. Set the same keys in the host dashboard
# for production. Never commit .env.

# The only place the domain is set. Drives canonical URLs, hreflang, Open Graph,
# the sitemap and robots.txt. On Cloudflare this must be a BUILD variable.
PUBLIC_SITE_URL="https://www.mhsv.ch"

# Reveals the legal status line, the legal footer and the legal-notice link.
# Stays false until the statutes are validated.
PUBLIC_SHOW_LEGAL_STATUS="false"

# Shows the "pending legal validation" notice on the data protection page.
PUBLIC_PRIVACY_IS_DRAFT="true"

# Server-side only, never exposed to the browser.
# CONTACT_TRANSPORT: log | brevo | smtp   ("log" writes to the function log and
# sends nothing. smtp cannot run on Cloudflare - Workers have no raw TCP.)
CONTACT_RECIPIENT="infos@mhsv.ch"
CONTACT_SENDER="website@mhsv.ch"
CONTACT_TRANSPORT="log"

# NEWSLETTER_PROVIDER: log | brevo | smtp
# brevo is double opt-in and needs the three BREVO_ values below.
# smtp emails the subscription to CONTACT_RECIPIENT; nobody is actually subscribed.
NEWSLETTER_PROVIDER="log"

# One key serves both the contact forms and the newsletter list.
BREVO_API_KEY=""
BREVO_LIST_ID=""
BREVO_DOI_TEMPLATE_ID=""
BREVO_DOI_REDIRECT_URL="https://www.mhsv.ch/fr/"

# Only when CONTACT_TRANSPORT="smtp".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Set to "yes" to make `npm run dev` send mail for real instead of logging it.
MHSV_DEV_SEND="no"
