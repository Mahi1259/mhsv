# ---------------------------------------------------------------------------
# MHSV® Phase 1 — environment configuration
# Copy to `.env` for local development. Set the same keys in the host dashboard
# (Netlify / Cloudflare) for production. Never commit `.env`.
# ---------------------------------------------------------------------------

# Canonical public origin, used for canonical tags, hreflang, OG and sitemap.
# BLOCKER #4: mhsv.ch vs mhsv-international.org not yet decided by the client.
PUBLIC_SITE_URL="https://www.mhsv.ch"

# ---------------------------------------------------------------------------
# Legal / association status gate — BLOCKER #1
#
# The content pack (§01, §21) specifies "Swiss non-profit association — Geneva"
# and a full legal footer. A later client instruction says NOT to display the
# association or legal status until the statutes are validated by the lawyer.
#
# Ship with "false" until the client answers. Flipping to "true" reveals:
#   - the hero legal-status line
#   - the legal footer block
#   - the /legal-notice/ page link in the footer
# No other code change is required.
# ---------------------------------------------------------------------------
PUBLIC_SHOW_LEGAL_STATUS="false"

# ---------------------------------------------------------------------------
# Privacy policy draft notice — BLOCKER #5
#
# The privacy policy has not been written by the client. The page ships with a
# developer-written draft carrying a visible "pending legal validation" notice.
# Set to "false" once the lawyer's final text replaces the privacy.sections
# bodies in src/content/authored/{loc}.json.
# ---------------------------------------------------------------------------
PUBLIC_PRIVACY_IS_DRAFT="true"

# ---------------------------------------------------------------------------
# Contact form (server-side only — these are NOT exposed to the browser)
# ---------------------------------------------------------------------------

# Recipient of contact-form submissions. Configurable by requirement — never
# hard-code this. BLOCKER #2: this mailbox does not exist yet.
CONTACT_RECIPIENT="infos@mhsv-international.org"

# Verified sender for the transactional provider. Must be on a domain you own
# and have authenticated (SPF/DKIM), otherwise delivery will fail.
CONTACT_SENDER="website@mhsv.ch"

# Transport: "resend" | "smtp" | "log"
# "log" writes the payload to the function log instead of sending — use it to
# test the full pipeline before the mailbox exists.
CONTACT_TRANSPORT="log"

# Required when CONTACT_TRANSPORT="resend"
RESEND_API_KEY=""

# Required when CONTACT_TRANSPORT="smtp"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
